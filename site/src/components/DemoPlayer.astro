---
// Plays one demo inside the page. Nothing from the game package is requested until the visitor asks: the button
// creates an iframe on /play/<Game>/ (the WEB-1 host page), and the host's messages
// ({ source: 'microengine', game, state, detail }) drive the status line and the controls.
import { Image } from 'astro:assets';
import type { DemoGame } from '../data/games';
import fs from 'node:fs';
import path from 'node:path';
import { playManifest, megabytes } from '../lib/play-manifest.mjs';
import { repoRoot } from '../lib/repo-docs.mjs';

interface Props { game: DemoGame }
const { game } = Astro.props;
const packaged = playManifest()?.games?.[game.id];
const download = packaged ? `about ${megabytes(packaged.transfer)}` : '';
// Packages built with on-screen touch controls say so in their game.json (INPUT-1); the page offers them to phones.
const gameJson = path.join(repoRoot, 'site', 'public', 'play', game.id, 'game.json');
const touch = fs.existsSync(gameJson) && JSON.parse(fs.readFileSync(gameJson, 'utf8')).touch === true;
---
<section class="player media-surface" data-player data-game={game.id} data-title={game.title} data-src={`/play/${game.id}/`}
  data-state={packaged ? 'checking' : 'missing'} data-touch={touch ? 'true' : 'false'} aria-label={`${game.title} player`} style={`--game: var(${game.colorToken})`}>
  <div class="stage" data-stage>
    <Image class="poster" src={game.shots[0].src} alt="" widths={[640, 960, 1440]} sizes="(min-width: 76rem) 72rem, 100vw" loading="eager" />
    <div class="panel" data-panel="checking">
      <div class="plate">
        <p class="legend">Browser check</p>
        <p>Checking this browser…</p>
        <noscript><p>The demos need JavaScript and WebAssembly. Screenshots and controls are below.</p></noscript>
      </div>
    </div>
    <div class="panel" data-panel="desktop">
      <div class="plate start">
        <p class="legend">Web build{download && ` · ${download}`}</p>
        <button type="button" class="button play" data-action="load"><span class="play-glyph" aria-hidden="true"></span>Play {game.title}</button>
        <p class="panel-note">Loads the game in this page: {download}. {touch ? 'Keyboard, gamepad or touch.' : 'Keyboard required.'}</p>
      </div>
    </div>
    <div class="panel" data-panel="unvalidated">
      <div class="plate" data-tone="partial">
        <p class="legend">Not tested on this device</p>
        <h2 class="panel-title">Made for a keyboard</h2>
        <p data-reason="touch">This device does not seem to have a keyboard and mouse. This version of the demo has no touch controls and was not tested on phones or tablets.</p>
        <p data-reason="small-screen">This window is smaller than the demos were tested at.</p>
        <div class="actions">
          <a class="button" href="#screenshots">See screenshots</a>
          <a class="button secondary" href="/docs/">Read the documentation</a>
        </div>
        <p class="panel-note">Have a keyboard connected? <button type="button" class="link-button" data-action="load">Try anyway</button> ({download}; the games are made for a keyboard, a gamepad or their on-screen controls).</p>
      </div>
    </div>
    <div class="panel" data-panel="unsupported">
      <div class="plate" data-tone="no">
        <p class="legend">Not supported</p>
        <h2 class="panel-title">This browser cannot run the demos</h2>
        <p>The games need WebAssembly and WebGL, which this browser does not offer. They were verified in Chrome and Firefox on desktop.</p>
        <div class="actions"><a class="button" href="#screenshots">See screenshots</a></div>
      </div>
    </div>
    <div class="panel" data-panel="failed">
      <div class="plate" data-tone="no">
        <p class="legend">Error</p>
        <h2 class="panel-title">The game stopped</h2>
        <p data-error-text>Something went wrong while loading or running the game.</p>
        <pre class="error-detail" data-error-detail hidden></pre>
        <div class="actions">
          <button type="button" class="button" data-action="restart">Reload the game</button>
          <button type="button" class="button secondary" data-action="exit">Close</button>
        </div>
      </div>
    </div>
    <div class="panel" data-panel="missing">
      <div class="plate">
        <p class="legend">No web package</p>
        <h2 class="panel-title">Not included in this build</h2>
        <p>This copy of the site was built without the web packages. Screenshots and controls are below.</p>
      </div>
    </div>
  </div>
  <div class="toolbar">
    <p class="player-status" role="status" aria-live="polite" data-status>{packaged ? '' : 'Game package not included.'}</p>
    <div class="toolbar-actions">
      <button type="button" class="button small secondary" data-action="fullscreen" hidden>Fullscreen</button>
      <button type="button" class="button small secondary" data-action="restart" hidden>Restart</button>
      <button type="button" class="button small secondary" data-action="exit" hidden>Exit</button>
    </div>
  </div>
</section>

<script>
  import { classify, probe } from '../lib/capability.mjs';

  const messages: Record<string, string> = {
    loading: 'Loading the engine and the game…',
    ready: 'Ready. Click or tap the game, or press any key, to start.',
    starting: 'Starting…',
    playing: 'Playing. To leave the game with the keyboard, press F6 or click outside it.',
    ended: 'The game has ended. Use “Play again” in the game, Restart, or Exit.',
    failed: 'The game stopped because of an error.',
  };

  for (const player of document.querySelectorAll<HTMLElement>('[data-player]')) setUp(player);

  function setUp(player: HTMLElement) {
    if (player.dataset.state === 'missing') return;
    const stage = player.querySelector<HTMLElement>('[data-stage]')!;
    const status = player.querySelector<HTMLElement>('[data-status]')!;
    const button = (action: string) => [...player.querySelectorAll<HTMLButtonElement>(`[data-action="${action}"]`)];
    const [fullscreen] = button('fullscreen');
    let frame: HTMLIFrameElement | null = null;
    let keyboardSeen = false;

    const show = (state: string, text = messages[state] ?? '') => {
      player.dataset.state = state;
      status.textContent = text;
    };

    // Recommendation only: an "unvalidated" device keeps a "Try anyway" button, and a hardware key press upgrades it.
    const evaluate = () => {
      if (frame) return;
      const { verdict, reasons } = classify(probe(window, keyboardSeen, player.dataset.touch === 'true'));
      for (const p of player.querySelectorAll<HTMLElement>('[data-reason]')) p.hidden = !reasons.includes(p.dataset.reason!);
      show(verdict, verdict === 'desktop' ? '' : verdict === 'unvalidated' ? 'Optimised for desktop browsers with a keyboard.' : 'This browser cannot run the demos.');
    };
    evaluate();
    window.addEventListener('keydown', event => { if (!keyboardSeen && event.isTrusted && !frame) { keyboardSeen = true; evaluate(); } });
    window.addEventListener('resize', () => evaluate());

    const setControls = (on: boolean) => {
      fullscreen.hidden = !on || !document.fullscreenEnabled;
      for (const b of [...button('restart'), ...button('exit')]) if (b.closest('.toolbar')) b.hidden = !on;
    };

    const load = () => {
      if (frame) return;
      frame = document.createElement('iframe');
      frame.src = player.dataset.src!;
      frame.title = `${player.dataset.title} (game)`;
      frame.allow = 'fullscreen; autoplay';
      frame.className = 'game-frame';
      stage.append(frame);
      setControls(true);
      show('loading');
    };

    const exit = () => {
      if (!frame) return;
      if (document.fullscreenElement === stage) document.exitFullscreen();
      // Navigating the frame away first lets the host end the run properly (it saves on pagehide).
      const old = frame;
      frame = null;
      old.src = 'about:blank';
      setTimeout(() => old.remove(), 50);
      setControls(false);
      evaluate();
      player.querySelector<HTMLButtonElement>('[data-panel="desktop"] [data-action="load"]')?.focus();
    };

    const restart = () => {
      if (!frame) return load();
      show('loading');
      frame.contentWindow?.location.reload();
    };

    for (const b of button('load')) b.addEventListener('click', load);
    for (const b of button('exit')) b.addEventListener('click', exit);
    for (const b of button('restart')) b.addEventListener('click', restart);
    fullscreen.addEventListener('click', () => {
      if (document.fullscreenElement) document.exitFullscreen();
      else stage.requestFullscreen().then(() => frame?.focus()).catch(() => { status.textContent = 'Fullscreen is not allowed here.'; });
    });
    document.addEventListener('fullscreenchange', () => {
      fullscreen.textContent = document.fullscreenElement === stage ? 'Exit fullscreen' : 'Fullscreen';
    });

    window.addEventListener('message', event => {
      const data = event.data;
      if (!frame || event.origin !== location.origin || event.source !== frame.contentWindow) return;
      if (data?.source !== 'microengine' || data.game !== player.dataset.game) return;
      if (data.state === 'failed') {
        const detail = player.querySelector<HTMLElement>('[data-error-detail]')!;
        detail.textContent = String(data.detail ?? '');
        detail.hidden = !data.detail;
        show('failed');
        return;
      }
      show(data.state);
      if (data.state === 'ready') frame.focus();
    });
  }
</script>

<style>
  /* The player is the demo's own frame, the only place on the page that carries the game's colour: a 2px rule on top,
     as on a DemoCard. Stage and toolbar are one graphite object in both themes (brand.css sets color-scheme: dark on
     [data-stage] and .media-surface on the whole player), seated one gap apart on a rule-coloured board. */
  .player { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--rule-gap); padding: var(--rule-gap);
    border-top: var(--rule-pixel) solid var(--game); background: var(--color-rule); border-radius: var(--radius-sm); }
  .stage { position: relative; aspect-ratio: 16 / 9; background: var(--color-paper); overflow: hidden; }
  .stage:fullscreen { aspect-ratio: auto; width: 100vw; height: 100vh; }
  .poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; image-rendering: pixelated; }
  .panel { position: absolute; inset: 0; display: none; padding: var(--space-md); background: var(--color-scrim); overflow-y: auto; }
  .player[data-state='checking'] [data-panel='checking'],
  .player[data-state='desktop'] [data-panel='desktop'],
  .player[data-state='unvalidated'] [data-panel='unvalidated'],
  .player[data-state='unsupported'] [data-panel='unsupported'],
  .player[data-state='failed'] [data-panel='failed'],
  .player[data-state='missing'] [data-panel='missing'] { display: flex; }
  /* Before Play the poster stays clear: the start plate is seated in the bottom-left corner, with no scrim. */
  .player[data-state='desktop'] [data-panel='desktop'] { align-items: flex-end; background: none; }

  /* Each state is a plate, like the label on a module: a mono legend that names the verdict, then the message. The
     rule on top repeats the verdict in its colour. */
  .plate { --tone: var(--color-ink-3); display: grid; justify-items: start; align-content: start; gap: var(--space-sm);
    width: min(100%, 36rem); margin: auto; padding: var(--space-md) var(--space-lg) var(--space-lg);
    background: var(--color-paper-2); border: var(--rule-thin) solid var(--color-rule);
    border-top: var(--rule-pixel) solid var(--tone); border-radius: var(--radius-sm); }
  .plate[data-tone='partial'] { --tone: var(--color-partial); }
  .plate[data-tone='no'] { --tone: var(--color-no); }
  .plate.start { --tone: var(--color-accent); width: auto; max-width: min(100%, 30rem); margin: 0;
    padding: var(--space-sm) var(--space-md) var(--space-md); }
  .plate p { margin: 0; max-width: 36rem; color: var(--color-ink); }
  .plate .legend { display: inline-flex; align-items: center; gap: var(--space-xs); font-family: var(--font-mono); font-size: var(--text-xs);
    text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--tone); }
  .legend::before { content: ''; flex: none; width: 0.625rem; height: 0.625rem; box-sizing: border-box; border: var(--rule-pixel) solid currentColor; }
  .plate[data-tone] .legend::before, .start .legend::before { background: currentColor; }
  .plate:not([data-tone]):not(.start) .legend { color: var(--color-ink-2); }
  .panel-title { margin: 0; font-family: var(--font-display); font-weight: var(--weight-display); font-size: var(--text-xl);
    line-height: var(--leading-snug); letter-spacing: var(--tracking-display); color: var(--color-ink); }
  .plate .panel-note { font-size: var(--text-sm); color: var(--color-ink-2); }
  .button.play { font-size: var(--text-lg); padding-inline: var(--space-lg) var(--space-xl); }
  /* The play glyph is a triangle drawn with borders in the button's own ink. */
  .play-glyph { width: 0; height: 0; border-block: 0.4em solid transparent; border-inline-start: 0.62em solid currentColor; }
  .link-button { display: inline-flex; align-items: center; min-height: var(--tap); padding: 0 var(--space-2xs); border: 0; background: none;
    color: var(--color-accent); font: inherit; text-decoration: underline; text-underline-offset: 0.2em; cursor: pointer; vertical-align: baseline; }
  .link-button:hover { color: var(--color-accent-strong); }
  .error-detail { width: 100%; max-height: 8rem; overflow: auto; margin: 0; padding: var(--space-xs); text-align: left;
    font-size: var(--text-xs); color: var(--color-no); background: var(--color-paper); border: var(--rule-thin) solid var(--color-rule); white-space: pre-wrap; }
  .error-detail[hidden] { display: none; }
  .stage :global(.game-frame) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: var(--color-paper); }

  /* The toolbar is the strip under the stage: the status in mono, the controls on the right. */
  .toolbar { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-sm); align-items: center; justify-content: space-between;
    min-height: var(--tap); padding: var(--space-2xs) var(--space-sm); background: var(--color-paper-2); }
  .toolbar .player-status { margin: 0; font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-ink-2); }
  .toolbar-actions { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .player :focus-visible { outline: 3px solid var(--color-focus); outline-offset: 2px; }
  /* On graphite the focus colour is close to the amber fill: a primary button's ring is drawn in ink instead. */
  .player .button:not(.secondary):focus-visible { outline-color: var(--color-ink); }
  @media (max-width: 40rem) {
    /* On a narrow screen the message panels need more room than a 16:9 box gives them. */
    .player:not([data-state='desktop']):not([data-state='loading']):not([data-state='ready']):not([data-state='starting']):not([data-state='playing']):not([data-state='ended']) .stage { aspect-ratio: auto; min-height: 26rem; }
    .panel { padding: var(--space-sm); }
    .plate { padding: var(--space-sm) var(--space-md) var(--space-md); }
    /* The start plate must fit the 16:9 poster: the legend already gives the size, so the note waits for wider screens. */
    .plate.start { max-width: 100%; gap: var(--space-xs); padding: var(--space-xs) var(--space-sm) var(--space-sm); }
    .plate.start .panel-note { display: none; }
    .button.play { font-size: var(--text-md); }
  }
</style>
