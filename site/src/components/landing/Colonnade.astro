---
// The opening figure: the board of the mark built as an object in space. A lintel (the kernel) stands on walls; the
// bays between them are the sockets; four hold the modules that ship today and the fifth is empty, because there is
// always room for another. It is the picture the film "Room for another" is made of (media/room-for-another), drawn
// here with flat-shaded CSS boxes so the page can turn it as the reader scrolls (--p, set by scripts/scroll.ts).
// Colours come from the tokens: the board in ink, each module in its family's colour.
import { families } from '../brand/geometry.mjs';

// Units: one unit is 1% of the figure's width (container query units), so the figure scales as one object.
const WALL = 2.4, BAY = 14, PITCH = WALL + BAY, BAYS = 5, DEPTH = 16;
const WIDTH = BAYS * BAY + (BAYS + 1) * WALL;
const WALL_HEIGHT = 26, LINTEL = 5;
const left = -WIDTH / 2;
const seated = ['platform', 'graphics', 'audio', 'input'] as const;
const walls = Array.from({ length: BAYS + 1 }, (_, i) => left + WALL / 2 + i * PITCH);
const bayCentre = (i: number) => left + WALL + BAY / 2 + i * PITCH;
// y grows downwards; the floor is at +13, so the board is centred on the figure.
const FLOOR = (WALL_HEIGHT + LINTEL) / 2;
const box = (w: number, h: number, d: number, x: number, y: number) => `--w:${w};--h:${h};--d:${d};--x:${x};--y:${y}`;
---
<div class="colonnade" role="img" aria-label="MicroEngine drawn as a structure: a kernel bar standing on walls, with five sockets between them. Four hold the modules that ship today: platform, graphics, audio and input. The fifth is empty.">
  <div class="stage" aria-hidden="true">
    <div class="camera">
      <div class="box board" style={box(WIDTH, LINTEL, DEPTH, 0, FLOOR - WALL_HEIGHT - LINTEL / 2)}>
        <span class="face front"></span><span class="face top"></span><span class="face side-l"></span><span class="face side-r"></span>
      </div>
      {walls.map(x => (
        <div class="box board" style={box(WALL, WALL_HEIGHT, DEPTH, x, FLOOR - WALL_HEIGHT / 2)}>
          <span class="face front"></span><span class="face side-l"></span><span class="face side-r"></span>
        </div>
      ))}
      {seated.map((family, i) => (
        <div class="box module" data-family={family} style={`${box(BAY - 3, WALL_HEIGHT - 3, DEPTH - 4, bayCentre(i), FLOOR - (WALL_HEIGHT - 3) / 2)};--i:${i}`}>
          <span class="face front">
            <svg viewBox="0 0 16 16"><path fill-rule="evenodd" d={families[family].board} /><path class="seat" d={families[family].module} /></svg>
            <span class="name">{families[family].label}</span>
          </span>
          <span class="face top"></span><span class="face side-l"></span><span class="face side-r"></span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  /* Hallmark · component: opening figure · genre: editorial · theme: custom "Socket" (site/design/README.md)
   * pre-emit critique: P5 H4 E4 S5 R4 V4 */
  .colonnade { container-type: inline-size; width: 100%; aspect-ratio: 100 / 62; overflow: hidden; }
  .stage { --u: 1cqw; position: relative; width: 100%; height: 100%; perspective: calc(150 * var(--u)); perspective-origin: 50% 42%; }
  .camera, .box { position: absolute; left: 50%; top: 52%; width: 0; height: 0; transform-style: preserve-3d; }
  /* The camera stands to the left and a little above; scrolling brings it round towards the front. */
  .camera { transform: scale3d(1.02, 1.02, 1.02) rotateX(-12deg) rotateY(-24deg); }
  .box { left: 0; top: 0; transform: translate3d(calc(var(--x) * var(--u)), calc(var(--y) * var(--u)), calc(var(--z, 0) * var(--u))); }
  /* A seated module stands a little proud of the board, so its face is never hidden by the walls. */
  .module { --z: 3; }
  .face { position: absolute; backface-visibility: hidden; }
  .front { width: calc(var(--w) * var(--u)); height: calc(var(--h) * var(--u)); left: calc(var(--w) * var(--u) / -2); top: calc(var(--h) * var(--u) / -2);
    transform: translateZ(calc(var(--d) * var(--u) / 2)); }
  .top { width: calc(var(--w) * var(--u)); height: calc(var(--d) * var(--u)); left: calc(var(--w) * var(--u) / -2); top: calc(var(--d) * var(--u) / -2);
    transform: rotateX(90deg) translateZ(calc(var(--h) * var(--u) / 2)); }
  .side-l, .side-r { width: calc(var(--d) * var(--u)); height: calc(var(--h) * var(--u)); left: calc(var(--d) * var(--u) / -2); top: calc(var(--h) * var(--u) / -2); }
  .side-l { transform: rotateY(-90deg) translateZ(calc(var(--w) * var(--u) / 2)); }
  .side-r { transform: rotateY(90deg) translateZ(calc(var(--w) * var(--u) / 2)); }

  /* Flat shading, three tones a colour, as in the film: no gradients and no shadows. */
  .board .front { background: var(--color-ink); }
  .board .top { background: color-mix(in oklch, var(--color-ink) 72%, var(--color-paper)); }
  .board .side-l, .board .side-r { background: color-mix(in oklch, var(--color-ink) 86%, var(--color-paper)); }
  .module .front { background: var(--family-color); display: grid; place-content: center; justify-items: center; gap: calc(1.4 * var(--u)); }
  .module .top { background: color-mix(in oklch, var(--family-color) 70%, var(--color-paper)); }
  .module .side-l, .module .side-r { background: color-mix(in oklch, var(--family-color) 78%, var(--color-ink)); }
  .module svg { width: calc(6.4 * var(--u)); height: calc(6.4 * var(--u)); fill: var(--color-paper); }
  .module .seat { opacity: 0.6; }
  .module .name { font: 500 calc(1.55 * var(--u))/1 var(--font-mono); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--color-paper); }

  /* On load each module slides into its bay from the reader's side, one after another. */
  .module { animation: arrive 420ms var(--ease-out) calc(180ms + var(--i) * 110ms) both; }
  @keyframes arrive { from { translate: 0 0 calc(46 * var(--u)); opacity: 0; } to { translate: 0 0 0; opacity: 1; } }
  :global(html.scroll-live) .camera { transform: scale3d(1.02, 1.02, 1.02) rotateX(calc(-12deg + var(--p, 0) * 6deg)) rotateY(calc(-24deg + var(--p, 0) * 22deg)); }
  @media (prefers-reduced-motion: reduce) { .module { animation: none; } }
</style>
