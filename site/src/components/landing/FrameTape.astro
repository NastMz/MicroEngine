---
// Frames captured from a running game, moving under a fixed playhead as the reader scrolls: the frames it has passed
// are drawn in full, the ones still to come are faint. It is the picture of the film "Every step" (media/every-step)
// made from real output, and the page's way of saying that a game is time cut into equal steps.
// Frames must be real captures; every frame needs alt text. Progress comes from this element's own data-scroll
// (--p and --step, scripts/scroll.ts). Without it the strip scrolls sideways like any frame strip and takes focus,
// so a keyboard can scroll it.
interface Frame { src: string; alt: string; width?: number; height?: number }
interface Props { frames: Frame[]; caption: string }
const { frames, caption } = Astro.props;
if (!frames.length) throw new Error('FrameTape: no frames');
for (const frame of frames) if (!frame.alt?.trim()) throw new Error(`FrameTape: frame ${frame.src} has no alt text`);
const pad = (n: number) => String(n).padStart(2, '0');
---
<figure class="frame-tape" data-scroll="through" data-scroll-steps={frames.length} style={`--count:${frames.length}`}>
  <div class="window" tabindex="0" role="group" aria-label={caption}>
    <ol class="track">
      {frames.map((frame, i) => (
        <li style={`--i:${i}`}>
          <span class="step" aria-hidden="true">{pad(i + 1)}</span>
          <img src={frame.src} alt={frame.alt} width={frame.width} height={frame.height} loading="lazy" decoding="async" />
        </li>
      ))}
    </ol>
    <span class="head" aria-hidden="true"></span>
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .frame-tape { --frame: clamp(11rem, 30vw, 21rem); --gap: var(--space-xs); margin: 0; display: grid; gap: var(--space-sm); min-width: 0; }
  .window { position: relative; overflow-x: auto; min-width: 0; }
  .track { list-style: none; margin: 0; padding: var(--space-sm) 0 var(--space-xs); display: flex; gap: var(--gap); width: max-content; }
  .track li { display: grid; gap: var(--space-2xs); width: var(--frame); flex: none; }
  .step { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--tracking-label); color: var(--color-ink-2);
    padding-top: var(--space-2xs); border-top: var(--rule-pixel) solid var(--color-ink); }
  .track img { width: 100%; height: auto; display: block; image-rendering: pixelated; border: var(--rule-thin) solid var(--color-rule); background: var(--color-paper-2); }
  .head { display: none; }
  figcaption { font-size: var(--text-sm); color: var(--color-ink-2); max-width: var(--measure); }

  /* Tied to the scroll: the window no longer scrolls by itself; the track runs under a playhead a third of the way in. */
  :global(html.scroll-live) .window { overflow: hidden; }
  :global(html.scroll-live) .track { padding-inline-start: 32%;
    transform: translateX(calc(var(--p, 0) * var(--count) * -1 * (var(--frame) + var(--gap)))); will-change: transform; }
  :global(html.scroll-live) .track li { opacity: calc(0.3 + 0.7 * clamp(0, var(--step, 99) - var(--i), 1)); transition: opacity var(--dur-mid) var(--ease-out); }
  :global(html.scroll-live) .head { display: block; position: absolute; top: 0; bottom: 0; left: 32%; width: var(--rule-pixel); background: var(--color-accent-fill); }
  /* The playhead carries the mark's module on top: three units wide. */
  :global(html.scroll-live) .head::before { content: ''; position: absolute; top: 0; left: calc(var(--rule-pixel) * -2); width: calc(var(--rule-pixel) * 5); height: var(--space-sm); background: var(--color-accent-fill); }
</style>
