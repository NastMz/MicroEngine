---
// The films: three short pieces about MicroEngine, each telling a different thing. A card shows a frame of the film,
// its name, what it tells and its length; pressing it opens a player over the page. Nothing of a film is requested
// before that: the cards are images, the player has no source until it opens, and it gives the source back when it
// closes. Without JavaScript a card is a plain link to the film's file.
// Data: src/data/films.ts (media/films.json). `heading` sets the level of the films' own headings.
import { getImage } from 'astro:assets';
import { films } from '../../data/films.ts';

interface Props { heading?: 'h2' | 'h3' }
const { heading: Heading = 'h3' } = Astro.props;
const cards = await Promise.all(films.map(async film => {
  const image = await getImage({ src: film.poster, width: 960, format: 'webp' });
  return { ...film, image: image.src, height: Math.round((960 * film.poster.height) / film.poster.width) };
}));
---
<ul class="films">
  {cards.map((film, i) => (
    <li class="film" id={`film-${film.slug}`} data-reveal style={`--i:${i}`}>
      <a class="film-open" href={film.src} data-film={film.slug} data-title={film.title} data-poster={film.image}
        aria-label={`Play ${film.title}: ${film.length}, with sound`}>
        <span class="media-surface poster">
          <img src={film.image} alt={`A frame of the film ${film.title}`} width="960" height={film.height} loading="lazy" decoding="async" />
          <span class="play" aria-hidden="true"><span class="play-mark"></span>Play · {film.length}</span>
        </span>
      </a>
      <div class="film-copy">
        <p class="label">{film.tells}</p>
        <Heading class="film-title">{film.title}</Heading>
        <p class="film-story">{film.story}</p>
      </div>
    </li>
  ))}
</ul>
<p class="films-note">Music and sound effects, no speech. Each film is under a minute and plays from GitHub when you press it.</p>

<dialog class="film-dialog media-surface" aria-labelledby="film-dialog-title">
  <div class="film-bar">
    <p class="film-now" id="film-dialog-title"></p>
    <form method="dialog"><button class="button small secondary" type="submit">Close</button></form>
  </div>
  <video class="film-video" controls playsinline preload="none"></video>
</dialog>

<style>
  /* Hallmark · component: film cards and player · genre: editorial · theme: custom "Socket"
   * states: default · hover · focus · active · (a link: no disabled, loading, error or success of its own)
   * pre-emit critique: P4 H4 E4 S5 R5 V4 */
  .films { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-xl) var(--space-lg); grid-template-columns: minmax(0, 1fr); }
  .film { display: grid; gap: var(--space-sm); align-content: start; min-width: 0; }
  .film-open { display: block; color: inherit; text-decoration: none; }
  .poster { position: relative; display: block; border: var(--rule-thin) solid var(--color-rule); background: var(--color-paper-2); overflow: hidden; }
  .poster img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  /* The play control: a label strip seated in the corner of the frame, with the mark's module as its sign. */
  .play { position: absolute; left: 0; bottom: 0; display: inline-flex; align-items: center; gap: var(--space-xs); min-height: var(--tap);
    padding: var(--space-2xs) var(--space-md); background: var(--color-accent-fill); color: var(--color-accent-ink);
    font: 500 var(--text-sm)/1 var(--font-mono); letter-spacing: var(--tracking-label); text-transform: uppercase;
    transition: background-color var(--dur-fast) var(--ease-out); }
  .play-mark { width: 0; height: 0; border-block: 0.4em solid transparent; border-inline-start: 0.62em solid currentColor; }
  .film-open:hover .play { background: var(--color-accent-fill-hover); }
  .film-open:active .play { transform: translateY(1px); }
  .film-open:focus-visible { outline-offset: 4px; }
  .film-copy { display: grid; gap: var(--space-2xs); }
  .film-title { font-family: var(--font-display); font-weight: var(--weight-display); font-size: var(--text-xl); letter-spacing: var(--tracking-display); line-height: 1.15; }
  .film-story { color: var(--color-ink-2); max-width: 34ch; }
  .films-note { margin-top: var(--space-lg); font-size: var(--text-sm); color: var(--color-ink-2); }

  /* The player: a graphite sheet over the page, the video as large as the window allows. */
  .film-dialog { width: min(100vw - 2 * var(--gutter), 72rem); max-width: none; max-height: none; padding: 0; border: var(--rule-thin) solid var(--color-rule);
    border-radius: var(--radius-sm); background: var(--color-paper); color: var(--color-ink); }
  .film-dialog::backdrop { background: var(--color-scrim); }
  .film-bar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); padding: var(--space-xs) var(--space-xs) var(--space-xs) var(--space-md); }
  .film-now { font: 500 var(--text-sm)/1.2 var(--font-mono); letter-spacing: var(--tracking-label); text-transform: uppercase; }
  .film-video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; max-height: calc(100vh - 8rem); background: var(--color-paper-2); }

  @media (min-width: 48rem) { .films { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>

<script>
  // Opens a film in the player. The video gets its source here and loses it on close, so a film that is not being
  // watched costs nothing.
  const dialog = document.querySelector<HTMLDialogElement>('.film-dialog');
  const video = dialog?.querySelector<HTMLVideoElement>('.film-video');
  const now = dialog?.querySelector<HTMLElement>('.film-now');
  if (dialog && video && now && typeof dialog.showModal === 'function') {
    for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-film]')) {
      link.addEventListener('click', event => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        now.textContent = link.dataset.title ?? '';
        video.poster = link.dataset.poster ?? '';
        video.src = link.href;
        dialog.showModal();
        video.focus();
        // Playback starts from the press that opened the player; a browser that refuses leaves the controls ready.
        video.play().catch(() => {});
      });
    }
    dialog.addEventListener('close', () => {
      video.pause();
      video.removeAttribute('src');
      video.removeAttribute('poster');
      video.load();
    });
    // A press on the backdrop closes the player, like the Close button and Escape.
    dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
  }
</script>
