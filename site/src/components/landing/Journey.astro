---
// The journey: the landing's opening, told as one continuous flight through a 3D world that the reader drives by
// scrolling (scripts/journey.ts, scripts/journey/scene.ts). Six chapters of words are shown while the camera is in
// their part of the world: the kernel, the pieces that dock around it, a game that plays above the assembly, the
// finished games hanging in depth, the loop as a tape of steps, and the mark.
//
// The markup is plain chapters, each with a still of its scene. That is what a reader gets with reduced motion,
// without WebGL or without JavaScript, and what a screen reader reads. With html.journey-live the section becomes
// ten windows tall, its stage sticks to the window, and the chapters are laid over the picture.
// `data-from` and `data-to` are the progress at which a chapter's words come and go (scene.ts, `beats`).
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { families } from '../brand/geometry.mjs';
import { demoGames } from '../../data/games';
import { distribution, sdk } from '../../data/distribution';
import score from '../../../../media/every-step/assets/score.json' with { type: 'json' };

// One real capture per demo, in the order the camera meets them: the first plays above the assembly.
const order = ['NeonRift', 'MeadowRun', 'CourtyardKey', 'TrailDuel'];
const pick: Record<string, number> = { NeonRift: 1, MeadowRun: 2, CourtyardKey: 5, TrailDuel: 3 };
const games = await Promise.all(order.map(async id => {
  const game = demoGames.find(g => g.id === id)!;
  const image = await getImage({ src: game.shots[pick[id]].src, width: 1280, format: 'webp' });
  return { title: game.title, url: image.src };
}));
const icons = Object.fromEntries(Object.entries(families).filter(([, f]) => f.module).map(([name, f]) => [name, [f.board, f.module]]));
// The tape is the score of the film "Every step": the same steps the film draws.
const tape = ['lead', 'bell', 'arp', 'pad', 'bass', 'hat', 'snare', 'kick'].map(name => score.voices.find(v => v.Name === name)!.Steps);
const data = JSON.stringify({ games: games.map(g => g.url), icons, tape });

// Stills of each chapter's scene, in both themes (site/scripts/journey-stills.mjs writes them).
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/journey/*.png', { eager: true });
const still = async (name: string) => {
  const found = Object.entries(files).find(([path]) => path.endsWith(`/${name}.png`));
  return found ? (await getImage({ src: found[1].default, width: 1120, format: 'webp' })).src : null;
};
const chapters = [
  { id: 'kernel', from: 0, to: 0.095, place: 'left' },
  { id: 'pieces', from: 0.115, to: 0.265, place: 'left' },
  { id: 'game', from: 0.285, to: 0.35, place: 'left' },
  { id: 'games', from: 0.435, to: 0.615, place: 'plate' },
  { id: 'loop', from: 0.68, to: 0.835, place: 'left', inverse: true },
  { id: 'mark', from: 0.935, to: 1, place: 'end' },
];
const stills = Object.fromEntries(await Promise.all(chapters.map(async c => [c.id, { light: await still(`${c.id}-light`), dark: await still(`${c.id}-dark`) }])));
const scene = (id: string) => chapters.find(c => c.id === id)!;
---
<section class="journey" id="journey" data-journey aria-label="MicroEngine, from the kernel to the mark">
  <script type="application/json" set:html={data}></script>
  <span class="journey-inverse flip" aria-hidden="true"></span>
  <div class="journey-stage">
    <canvas aria-hidden="true"></canvas>

    <div class:list={['chapter', scene('kernel').place]} data-from={scene('kernel').from} data-to={scene('kernel').to}>
      <div class="words">
        <p class="sdk-line" data-status="available">
          <span class="status-mark" aria-hidden="true"></span>
          <span>SDK {sdk.stage} <span class="mono">{sdk.version}</span> on nuget.org</span>
          <a href="/docs/sdk/">What Alpha means</a>
        </p>
        <h1 id="opening-title">A game engine that orchestrates, not reinvents.</h1>
        <p class="lede">MicroEngine is a code-first game engine for C# and .NET. At its centre is a small kernel; everything else connects to it.</p>
        <div class="actions">
          <a class="button" href={distribution.startHref}>Get started</a>
          <a class="button secondary" href="/demos/">Play the demos</a>
          <a class="quiet-link" href="#develop">Skip the tour</a>
        </div>
        <p class="hint" aria-hidden="true"><span class="hint-mark"></span>Scroll</p>
      </div>
      <figure class="still">{stills.kernel.light && <><img class="light" src={stills.kernel.light} alt="" loading="lazy" width="1120" height="630" /><img class="dark" src={stills.kernel.dark} alt="" loading="lazy" width="1120" height="630" /></>}</figure>
    </div>

    <div class:list={['chapter', scene('pieces').place]} data-from={scene('pieces').from} data-to={scene('pieces').to}>
      <div class="words">
        <p class="label">The kernel</p>
        <h2>One kernel. Pieces that connect to it.</h2>
        <p>Graphics, physics, audio, input, platforms and tools are modules. Each connects to the kernel through a contract, so an implementation can be chosen, replaced or written by you.</p>
        <p><a href="#modules">See every module on the board</a></p>
      </div>
      <figure class="still">{stills.pieces.light && <><img class="light" src={stills.pieces.light} alt="" loading="lazy" width="1120" height="630" /><img class="dark" src={stills.pieces.dark} alt="" loading="lazy" width="1120" height="630" /></>}</figure>
    </div>

    <div class:list={['chapter', scene('game').place]} data-from={scene('game').from} data-to={scene('game').to}>
      <div class="words">
        <p class="label">A configuration</p>
        <h2>Assembled for a game.</h2>
        <p>A game is an ordinary .NET program on top of the pieces it needs. It talks to contracts, never to a platform, so the same game runs wherever the engine does.</p>
      </div>
      <figure class="still">{stills.game.light && <><img class="light" src={stills.game.light} alt="" loading="lazy" width="1120" height="630" /><img class="dark" src={stills.game.dark} alt="" loading="lazy" width="1120" height="630" /></>}</figure>
    </div>

    <div class:list={['chapter', scene('games').place]} data-from={scene('games').from} data-to={scene('games').to}>
      <div class="words">
        <p class="label">Proof</p>
        <h2>Four finished games built with it.</h2>
        <p>{games.map(g => g.title).join(', ').replace(/, ([^,]*)$/, ' and $1')}: complete games you can play in the browser, right now.</p>
        <div class="actions"><a class="button" href="/demos/">Play the demos</a></div>
      </div>
      <figure class="still">{stills.games.light && <><img class="light" src={stills.games.light} alt="" loading="lazy" width="1120" height="630" /><img class="dark" src={stills.games.dark} alt="" loading="lazy" width="1120" height="630" /></>}</figure>
    </div>

    <div class:list={['chapter', scene('loop').place, 'flip']} data-from={scene('loop').from} data-to={scene('loop').to}>
      <div class="words">
        <p class="label">The loop</p>
        <h2>The loop owns time.</h2>
        <p>A game runs in fixed steps of the same length, and every frame does the same things in the same order: read the input, run the steps, draw once. Scripted input replays a game step for step, which is how the demos are played from start to finish by tests.</p>
        <p><a href="/docs/manual/lifecycle/">The lifecycle in the manual</a></p>
      </div>
      <figure class="still">{stills.loop.light && <><img class="light" src={stills.loop.light} alt="" loading="lazy" width="1120" height="630" /><img class="dark" src={stills.loop.dark} alt="" loading="lazy" width="1120" height="630" /></>}</figure>
    </div>

    <div class:list={['chapter', scene('mark').place]} data-from={scene('mark').from} data-to={scene('mark').to}>
      <div class="words">
        <p class="wordmark-line">MicroEngine</p>
        <h2>There is always room for another module.</h2>
        <div class="actions">
          <a class="button" href={distribution.startHref}>Get started</a>
          <a class="button secondary" href="/docs/">Read the docs</a>
          <a class="quiet-link" href="#films">Watch the films</a>
        </div>
      </div>
      <figure class="still">{stills.mark.light && <><img class="light" src={stills.mark.light} alt="" loading="lazy" width="1120" height="630" /><img class="dark" src={stills.mark.dark} alt="" loading="lazy" width="1120" height="630" /></>}</figure>
    </div>
  </div>
</section>

<style>
  /* Hallmark · macrostructure: one pinned stage, six chapters · tone: technical, precise, warm
   * theme: custom "Socket" (site/design/README.md) · pre-emit critique: P5 H4 E4 S5 R4 V5 */
  .journey { position: relative; }
  .journey-inverse { display: none; }
  canvas { display: none; }
  .hint { display: none; }

  /* Plain chapters: words beside a still of the scene. */
  .journey-stage { display: grid; gap: var(--space-3xl); width: 100%; max-width: var(--page-max); margin-inline: auto; padding: var(--space-2xl) var(--gutter) 0; }
  .chapter { display: grid; gap: var(--space-lg); align-items: center; min-width: 0; }
  .chapter.flip { padding: var(--space-xl) var(--space-lg); background: var(--color-paper); color: var(--color-ink); }
  .words { display: grid; gap: var(--space-md); min-width: 0; justify-items: start; }
  .words > p:not(.label):not(.sdk-line):not(.hint) { color: var(--color-ink-2); max-width: 34rem; }
  h1 { font-size: var(--text-hero); overflow-wrap: normal; }
  h2 { font-size: var(--text-hero); max-width: 16ch; }
  .sdk-line { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2xs) var(--space-sm); font-size: var(--text-sm); color: var(--color-ink-2); }
  .quiet-link { display: inline-flex; align-items: center; min-height: var(--tap); padding-inline: var(--space-xs); font-family: var(--font-mono); font-size: var(--text-sm); }
  .wordmark-line { font-family: var(--font-display); font-weight: var(--weight-display); font-size: var(--text-display); line-height: 1; letter-spacing: var(--tracking-display); color: var(--color-ink); }
  .still { margin: 0; min-width: 0; }
  .still img { width: 100%; height: auto; border: var(--rule-thin) solid var(--color-rule); }
  .still .dark { display: none; }
  :global(:root[data-theme='dark']) .still .light { display: none; }
  :global(:root[data-theme='dark']) .still .dark { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .still .light { display: none; }
    :global(:root:not([data-theme='light'])) .still .dark { display: block; }
  }
  .flip { color-scheme: dark; }
  :global(:root[data-theme='dark']) .flip { color-scheme: light; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme='light'])) .flip { color-scheme: light; } }
  @media (min-width: 64rem) { .chapter { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: var(--space-2xl); } }

  /* Live: the section is a timeline ten windows long, the stage is the window, and the words lie over the picture. */
  :global(html.journey-live) .journey { height: 1000vh; height: 1000svh; }
  :global(html.journey-live) .journey-stage { position: sticky; top: 0; display: block; max-width: none; padding: 0; height: 100vh; height: 100svh; overflow: hidden; }
  :global(html.journey-live) canvas { display: block; position: absolute; inset: 0; width: 100%; height: 100%; }
  :global(html.journey-live) .still { display: none; }
  :global(html.journey-live) .chapter { position: absolute; inset: 0; display: block; padding: 0; background: none; opacity: 0; will-change: opacity, transform; pointer-events: none; }
  :global(html.journey-live) .chapter:first-of-type { opacity: 1; }
  :global(html.journey-live) .words { position: absolute; pointer-events: auto; left: max(var(--gutter), (100vw - var(--page-max)) / 2 + var(--gutter)); width: min(34rem, 100vw - 2 * var(--gutter)); }
  :global(html.journey-live) .left .words { top: 50%; transform: translateY(-50%); }
  /* Over a picture of a game the words sit on a plate of paper, like a caption strip. */
  :global(html.journey-live) .plate .words { bottom: var(--space-2xl); padding: var(--space-lg); background: var(--color-paper); border: var(--rule-thin) solid var(--color-rule); }
  :global(html.journey-live) .plate h2 { font-size: var(--text-2xl); }
  :global(html.journey-live) .end .words { left: 50%; top: 62%; transform: translateX(-50%); justify-items: center; text-align: center; width: min(44rem, 100vw - 2 * var(--gutter)); }
  :global(html.journey-live) .end h2 { max-width: none; font-size: var(--text-2xl); }
  :global(html.journey-live) .end .actions { justify-content: center; }
  :global(html.journey-live) .hint { display: inline-flex; align-items: center; gap: var(--space-xs); margin-top: var(--space-md); font-family: var(--font-mono); font-size: var(--text-xs);
    letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--color-ink-2); }
  :global(html.journey-live) .hint-mark { width: var(--rule-pixel); height: var(--space-lg); background: var(--color-accent-fill); }

  /* On a narrow screen the picture fills the window and the words take its lower part, on paper. */
  @media (max-width: 63.99rem) {
    :global(html.journey-live) .words, :global(html.journey-live) .left .words, :global(html.journey-live) .end .words {
      left: 0; right: 0; top: auto; bottom: 0; width: auto; transform: none; justify-items: start; text-align: left;
      padding: var(--space-lg) var(--gutter) var(--space-xl); background: var(--color-paper); border-top: var(--rule-thin) solid var(--color-rule); }
    :global(html.journey-live) .plate .words { border-inline: 0; border-bottom: 0; }
    :global(html.journey-live) h1, :global(html.journey-live) h2, :global(html.journey-live) .end h2 { font-size: var(--text-2xl); }
    :global(html.journey-live) .end .actions { justify-content: flex-start; }
    :global(html.journey-live) .hint { display: none; }
  }
</style>
