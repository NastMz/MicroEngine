---
// The landing's compact platform list: one line per target with its support level, the command that packages a game
// for it and what that command produces. The details (runtime, requirements, limits) are on /platforms/
// (src/data/platforms.ts, the single source of these rows).
import { platforms, supportLabels } from '../data/platforms';

// `build` reads "microengine package <target>, on <system>: <what it produces>"; show the command and the product.
const rows = platforms.map(row => {
  const command = row.build.match(/^microengine package [\w-]+/)?.[0];
  const colon = row.build.indexOf(': ');
  return { ...row, command, product: colon >= 0 ? row.build.slice(colon + 2) : row.build };
});
---
<ul class="platform-list">
  {rows.map(row => (
    <li>
      <a class="platform-name" href={`/platforms/#${row.id}`}>{row.name}</a>
      <span class="platform-support"><span class={`status ${row.support === 'supported' ? 'ok' : 'partial'}`}>{supportLabels[row.support]}</span></span>
      {row.command && <code class="platform-command">{row.command}</code>}
      <span class="platform-product">{row.product}</span>
    </li>
  ))}
</ul>

<style>
  .platform-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr);
    border-top: var(--rule-thin) solid var(--color-rule); }
  .platform-list li { display: grid; gap: var(--space-2xs) var(--space-md); align-items: baseline; min-width: 0;
    grid-template-columns: minmax(0, 1fr) auto; padding-block: var(--space-sm); border-bottom: var(--rule-thin) solid var(--color-rule); }
  .platform-name { display: inline-flex; align-items: center; min-height: var(--space-xl); color: var(--color-ink);
    font-weight: 600; text-decoration: none; }
  .platform-name:hover { color: var(--color-accent); text-decoration: underline; }
  .platform-support { justify-self: end; }
  .platform-command { grid-column: 1 / -1; font-size: var(--text-xs); color: var(--color-ink); overflow-wrap: anywhere; }
  .platform-product { grid-column: 1 / -1; font-size: var(--text-sm); color: var(--color-ink-2); }
  @media (min-width: 64rem) {
    .platform-list li { grid-template-columns: minmax(0, 10rem) minmax(0, 7rem) minmax(0, 17rem) minmax(0, 1fr); }
    .platform-support { justify-self: start; }
    .platform-command, .platform-product { grid-column: auto; }
  }
</style>
