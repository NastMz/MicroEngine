---
// Platform summary for the landing: one row per official target with its status, its platform profile and whether a
// download exists. The evidence behind each row is the matrix on /platforms/ (src/data/platforms.ts).
import { platforms } from '../data/platforms';
import { targets } from '../lib/versions.mjs';
import { playManifest } from '../lib/play-manifest.mjs';

const downloads = playManifest()?.downloads ?? {};
const released = new Set(Object.values(downloads).flatMap(byTarget => Object.keys(byTarget)));
const label = (row: (typeof platforms)[number]) => {
  if ('none' in row.download) return row.download.none;
  const target = targets.find(t => t.id === (row.download as { target: string }).target);
  return released.has(target.id) ? `Download: ${target.detail}` : `No ${target.label} package in the current release`;
};
---
<div class="table-scroll">
  <table class="plain">
    <thead><tr><th scope="col">Target</th><th scope="col">Status</th><th scope="col">Platform</th><th scope="col">Get the demos</th></tr></thead>
    <tbody>
      {platforms.map(row => (
        <tr>
          <th scope="row"><a href={`/platforms/#${row.id}`}>{row.name}</a></th>
          <td><span class={`status ${row.status.tone}`}>{row.status.label}</span></td>
          <td class="muted">{row.platform}</td>
          <td class="muted">{label(row)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  tbody th { font-family: var(--font-body); font-size: var(--text-sm); text-transform: none; letter-spacing: 0; font-weight: 600; }
  tbody th a { color: var(--color-ink); }
  @media (max-width: 40rem) {
    table, tbody, tr, th, td { display: block; }
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    tr { padding-block: var(--space-sm); border-bottom: var(--rule-thin) solid var(--color-rule); }
    tbody th, td { border: 0 !important; padding: var(--space-2xs) 0 !important; }
  }
</style>
