---
// Platform summary for the landing: one row per target with its support level, what a game runs on there and what
// players need. Details are on /platforms/ (src/data/platforms.ts).
import { platforms, supportLabels } from '../data/platforms';
---
<div class="table-scroll">
  <table class="plain">
    <thead><tr><th scope="col">Platform</th><th scope="col">Support</th><th scope="col">Runs on</th><th scope="col">Players need</th></tr></thead>
    <tbody>
      {platforms.map(row => (
        <tr>
          <th scope="row"><a href={`/platforms/#${row.id}`}>{row.name}</a></th>
          <td><span class={`status ${row.support === 'supported' ? 'ok' : 'partial'}`}>{supportLabels[row.support]}</span></td>
          <td class="muted">{row.runtime}</td>
          <td class="muted">{row.requires}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  tbody th { font-family: var(--font-body); font-size: var(--text-sm); text-transform: none; letter-spacing: 0; font-weight: 600; }
  tbody th a { color: var(--color-ink); }
  @media (max-width: 40rem) {
    table, tbody, tr, th, td { display: block; }
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    tr { padding-block: var(--space-sm); border-bottom: var(--rule-thin) solid var(--color-rule); }
    tbody th, td { border: 0 !important; padding: var(--space-2xs) 0 !important; }
  }
</style>
