---
// Draws the first PixelImage.FromMap sprite of a repository C# file as crisp SVG pixels, straight from its source.
import { pixelMap } from '../lib/source.mjs';

interface Props { file: string; scale?: number; label: string }
const { file, scale = 10, label } = Astro.props;
const sprite = pixelMap(file);
---
<svg class="pixel-sprite" viewBox={`0 0 ${sprite.width} ${sprite.height}`} width={sprite.width * scale} height={sprite.height * scale}
  shape-rendering="crispEdges" role="img" aria-label={label}>
  {sprite.pixels.map(p => <rect x={p.x} y={p.y} width="1" height="1" fill={p.color} />)}
</svg>

<style>
  .pixel-sprite { display: block; max-width: 100%; height: auto; }
</style>
