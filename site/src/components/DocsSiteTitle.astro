---
// Documentation header title: the MicroEngine lockup, linking back to the landing page (not the docs root).
import Lockup from './brand/Lockup.astro';
---
<a href="/" class="docs-title" aria-label="MicroEngine home">
  <Lockup />
</a>
<a href="/demos/" class="docs-section">Demos</a>
<a href="/roadmap/" class="docs-section">Roadmap</a>

<style>
  .docs-title { display: inline-flex; align-items: center; text-decoration: none; color: var(--sl-color-white);
    font-size: var(--text-lg); min-height: var(--tap); white-space: nowrap; }
  .docs-section { margin-inline-start: var(--space-sm); color: var(--sl-color-gray-3); text-decoration: none;
    font-family: var(--font-mono); font-size: var(--text-sm); white-space: nowrap; }
  .docs-section:hover, .docs-title:hover { color: var(--sl-color-accent); }
  @media (max-width: 30rem) { .docs-section { display: none; } }
</style>
