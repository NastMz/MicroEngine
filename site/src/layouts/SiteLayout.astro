---
// Shell for the landing and demo pages: metadata, header, footer. Documentation pages use Starlight's own shell
// with the same tokens and fonts.
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/brand.css';
import '../styles/site.css';
import Lockup from '../components/brand/Lockup.astro';
import { fixed } from '../components/brand/geometry.mjs';

interface Props { title: string; description: string; image?: string; noindex?: boolean; current?: 'home' | 'demos' | 'platforms' | 'roadmap' }
const { title, description, image = '/og.png', noindex = false, current } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === 'MicroEngine' ? 'MicroEngine — a code-first 2D game engine for C#' : `${title} · MicroEngine`;
const nav = [
  { href: '/demos/', label: 'Demos', key: 'demos' },
  { href: '/docs/', label: 'Docs', key: 'docs' },
  { href: '/platforms/', label: 'Platforms', key: 'platforms' },
  { href: '/roadmap/', label: 'Roadmap', key: 'roadmap' },
  { href: 'https://github.com/NastMz/MicroEngine', label: 'GitHub', key: 'github' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="theme-color" content={fixed.light.paper} media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content={fixed.dark.paper} media="(prefers-color-scheme: dark)" />
  {/* Both themes follow the system; a choice made with the documentation's theme switch (stored by Starlight)
      applies here too. Inline in the head, so the page never paints in the wrong theme first. */}
  <script is:inline>
    try {
      const stored = localStorage.getItem('starlight-theme');
      if (stored === 'light' || stored === 'dark') document.documentElement.dataset.theme = stored;
    } catch {}
  </script>
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="MicroEngine" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap header-row">
      <a href="/" class="wordmark" aria-label="MicroEngine home">
        <Lockup />
      </a>
      <nav aria-label="Main">
        <ul>
          {nav.map(item => (
            <li><a href={item.href} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </header>
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap footer-grid">
      <p class="footer-statement">Small engine. Finished games. Pixel art written in C#.</p>
      <nav aria-label="Footer">
        <ul>
          <li><a href="/demos/">Play the demos</a></li>
          <li><a href="/docs/">Documentation</a></li>
          <li><a href="/docs/manual/lifecycle/">Engine manual</a></li>
          <li><a href="/roadmap/">Roadmap</a></li>
          <li><a href="/docs/status/">What it offers</a></li>
          <li><a href="/docs/licensing/">Licensing</a></li>
          <li><a href="/docs/third-party-notices/">Third-party notices</a></li>
          <li><a href="https://github.com/NastMz/MicroEngine">Source on GitHub</a></li>
        </ul>
      </nav>
      <p class="footer-meta">MicroEngine is open source under the MIT License. The four demo games are not: they are all rights reserved. Third-party components and their licences, including the CC0 art and music of the demos and this site’s fonts, are listed in the third-party notices.</p>
    </div>
  </footer>
</body>
</html>
