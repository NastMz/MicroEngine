---
// Hallmark · macrostructure: Long Document in three acts (code, board, loop), each tied to the scroll, then the
// product's own pages · nav: N1b · footer: Ft3 grouped · tone: technical, precise, warm
// theme: custom "Socket" (site/design/README.md, tokens.css) · enrichment: the board built in space (Colonnade), real
// code beside what it draws (CodeToSprite), real frames under a playhead (FrameTape), the films (Films)
// pre-emit critique: P5 H4 E4 S5 R4 V5
//
// Narrative: what MicroEngine is (the opening, the board as an object), how a game is written (code becomes a
// sprite as the reader scrolls), how the engine is built (the stance, then the board, its modules seating as they
// arrive), how it runs (the loop: real frames under a playhead, on the inverted ground), the three films that tell
// those same three things, and then the product: what it draws, where it runs, the demos, where it stands, first
// steps and where it is going. Motion is a function of the scroll position (scripts/scroll.ts): it plays backwards,
// never holds the scroll, and is absent under reduced motion. Status words follow the design's rules: only what the
// published SDK carries is "Available".
import { Code } from 'astro:components';
import { getImage } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import Platforms from '../components/Platforms.astro';
import DemoCard from '../components/DemoCard.astro';
import BoardDrawing from '../components/landing/BoardDrawing.astro';
import Colonnade from '../components/landing/Colonnade.astro';
import CodeToSprite from '../components/landing/CodeToSprite.astro';
import FrameTape from '../components/landing/FrameTape.astro';
import Films from '../components/landing/Films.astro';
import SocketBoard from '../components/landing/SocketBoard.astro';
import CodeLabel from '../components/brand/CodeLabel.astro';
import FrameStrip from '../components/brand/FrameStrip.astro';
import Socket from '../components/brand/Socket.astro';
import { demoGames } from '../data/games';
import { distribution, sdk } from '../data/distribution';
import { facts, graphicsIds, upstream } from '../data/landing/content.ts';
import { availabilityLabels, byStatus, capabilities, socketStatus, type Availability } from '../data/capabilities.ts';
import { excerpt, pixelMap } from '../lib/source.mjs';

const sample = 'samples/HelloEngine/Program.cs';
// One step before the first row of the sample's sprite, one per row, one after the last (CodeToSprite).
const spriteSteps = pixelMap(sample).height + 1;
// The desktop catalog only: from its declaration to the blank line that ends it.
const catalogFile = 'src/MicroEngine.Desktop/DesktopLauncher.cs';
const catalog = excerpt(catalogFile, /public static PlatformCatalog CreateCatalog/, /^\s*$/);

// Meadow Run draws every pixel in code: four of its own captures, in the order a player meets them.
// What MicroEngine draws, by status, and where the whole project stands: both read from the capability list.
const graphics = graphicsIds.map(id => capabilities.find(c => c.id === id)!);
const statuses: Availability[] = ['available', 'repository', 'planned'];
const ledger = statuses.map(status => ({ status, items: byStatus(status) }));

const meadow = demoGames.find(g => g.id === 'MeadowRun')!;
const frames = await Promise.all(meadow.shots.slice(0, 4).map(async shot => {
  const image = await getImage({ src: shot.src, width: 640, format: 'png' });
  return { src: image.src, alt: shot.alt, width: 640, height: Math.round((640 * shot.src.height) / shot.src.width) };
}));
// Neon Rift's own captures, in the order a player meets them, for the tape under the playhead.
const neon = demoGames.find(g => g.id === 'NeonRift')!;
const tape = await Promise.all(neon.shots.map(async shot => {
  const image = await getImage({ src: shot.src, width: 640, format: 'png' });
  return { src: image.src, alt: shot.alt, width: 640, height: Math.round((640 * shot.src.height) / shot.src.width) };
}));
---
<SiteLayout title="MicroEngine" description="MicroEngine is a code-first game engine for C# and .NET: a small kernel with swappable modules, built on SDL 3, raylib and .NET. Games built with it run on Windows, Linux, macOS, Android, iOS and in browsers." current="home">
  <div class="page-tape" data-page-tape aria-hidden="true"><span class="playhead"></span></div>

  <section class="opening wrap" id="opening" aria-labelledby="opening-title" data-scroll="leave">
    <div class="opening-copy">
      <p class="sdk-line" data-status="available">
        <span class="status-mark" aria-hidden="true"></span>
        <span>SDK {sdk.stage} <span class="mono">{sdk.version}</span> on nuget.org</span>
        <a href="/docs/sdk/">What Alpha means</a>
      </p>
      <h1 id="opening-title">A game engine that orchestrates, not reinvents.</h1>
      <p class="lede">
        MicroEngine is a code-first game engine for C# and .NET developers. Today it makes 2D games that run on
        Windows, Linux, macOS, Android, iOS and in browsers. Inside, a small kernel holds graphics, physics, audio,
        input and platforms as modules that can be swapped, so the engine grows without rewriting what works.
      </p>
      <div class="actions">
        <a class="button" href={distribution.startHref}>Get started</a>
        <a class="button secondary" href="/demos/">Play the demos</a>
        <a class="quiet-link" href="#films">Watch the films</a>
      </div>
    </div>
    <figure class="opening-figure">
      <Colonnade />
    </figure>
    <dl class="facts">
      {facts.map(fact => <div><dt>{fact.term}</dt><dd>{fact.value}</dd></div>)}
    </dl>
  </section>

  <section class="act-pin" id="develop" aria-labelledby="develop-title" data-scroll="pin" data-scroll-steps={spriteSteps}>
    <div class="pin-inner wrap">
      <div class="split">
        <div class="section-head">
          <p class="label">Developer experience</p>
          <h2 id="develop-title">Code first, from the template to every target</h2>
          <ol class="workflow">
            <li><code>dotnet new microengine-game</code> or <code>microengine new</code> makes a game project that runs as it is.</li>
            <li>Scenes, rules and art are plain C#. A sprite can be a palette and a string map, like the one beside this; content files are there when you want them.</li>
            <li><code>microengine run</code> plays it; <code>microengine package</code> builds the same project for each platform.</li>
          </ol>
          <p><a href="/docs/examples/hello-engine/">Walk through the Hello Engine sample</a> · <a href="/docs/cli/">The microengine tool</a></p>
        </div>
        <CodeToSprite file={sample} from={/var palette = Art\.Palette/} to={/Atlas = new SpriteAtlasBuilder/}
          note="a sprite is a palette and a map" label="The star sprite, drawn from the map in the code beside it" />
      </div>
    </div>
  </section>

  <section class="section wrap" id="stance" aria-labelledby="stance-title">
    <div class="split">
      <div class="section-head">
        <p class="label">The stance</p>
        <h2 id="stance-title">Built on what already works</h2>
        <p>Windows, sound, GPUs, phones and browsers are solved problems, solved well by libraries with years of use behind them. MicroEngine selects them, puts one contract in front of them and coordinates them, and spends its own code on what a game needs on top: the loop, scenes, input actions, drawing, saves and the tools.</p>
        <p><a href="/docs/third-party-notices/">Third-party notices</a></p>
      </div>
      <ul class="credits" aria-label="Technologies MicroEngine builds on">
        {upstream.map((tech, i) => (
          <li data-reveal style={`--i:${i}`}>
            <span class="credit-socket"><span class="credit-module">{tech.name}</span></span>
            <span class="credit-role">{tech.role}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section wrap" id="modules" aria-labelledby="modules-title">
    <div class="split modules-intro">
      <div class="section-head">
      <p class="label">Modularity</p>
      <h2 id="modules-title">One kernel, modules that swap</h2>
      <p>Every subsystem is a socket with a contract; a module is one implementation seated in it. A game talks to the contracts, so the same game assembly runs on every platform, and a host can seat another module without touching game code. The board shows each module as it really is today.</p>
      </div>
      <figure class="parts-figure">
        <BoardDrawing />
      </figure>
    </div>
    <SocketBoard labelledby="modules-title" />
    <dl class="status-key">
      {statuses.map(status => (
        <div data-status={socketStatus[status]}><dt><span class="status-mark" aria-hidden="true"></span>{availabilityLabels[status].label}</dt>
          <dd>{status === 'available' ? 'seated: in the SDK on nuget.org' : status === 'repository' ? 'an empty dashed socket: in no package' : 'an empty dotted socket: not built'}</dd></div>
      ))}
    </dl>
    <div class="split catalog">
      <div class="section-head">
        <h3>Platforms are profiles, chosen by the host</h3>
        <p>This is the desktop launcher’s real catalog, in order of preference: the first that can run on the machine is the default, and <code>--platform</code> picks another. Add a profile of your own and it is offered the same way.</p>
        <p><a href="/docs/manual/backends/">Choosing, replacing and writing platforms</a> · <a href="/docs/architecture/">The architecture</a></p>
      </div>
      <figure class="code-surface">
        <CodeLabel file={catalogFile} lang="C#" family="platform" note="the official desktop platforms" />
        <Code code={catalog.code} lang="csharp" theme="github-dark-dimmed" />
      </figure>
    </div>
  </section>

  <section class="ground flip" id="loop" aria-labelledby="loop-title" data-scroll="enter">
    <div class="wrap ground-pad">
      <div class="section-head">
        <p class="label">The loop</p>
        <h2 id="loop-title">The loop owns time</h2>
        <p>A game runs in fixed steps of the same length, and every frame does the same things in the same order: read the input, run the steps, draw once. The rules of a game never depend on how fast a machine draws. Scripted input replays a game step for step, which is how the four demos are played from start to finish by tests, with no window.</p>
        <p><a href="/docs/manual/lifecycle/">The lifecycle in the manual</a> · <a href="/docs/architecture/">The architecture</a></p>
      </div>
      <FrameTape frames={tape} caption="Neon Rift, from its title screen to the Leviathan: frames captured from the game as it ran." />
    </div>
  </section>

  <section class="section wrap" id="films" aria-labelledby="films-title">
    <div class="section-head">
      <p class="label">Films</p>
      <h2 id="films-title">Three films, three stories</h2>
      <p>MicroEngine in under a minute, three times over. Every frame is code, the soundtrack comes from the engine’s own synthesizer, and the games on screen are really running.</p>
    </div>
    <Films />
    <p class="more"><a href="/films/">How they were made</a></p>
  </section>

  <section class="section wrap" id="graphics" aria-labelledby="graphics-title">
    <div class="section-head">
      <p class="label">Graphics</p>
      <h2 id="graphics-title">Pixel art and HD 2D</h2>
      <p>MicroEngine started with pixel-art games and draws them well: crisp scaling, sprites from code or files, tile maps, particles and light. A presentation for high-resolution 2D art and TrueType fonts sits beside them. 3D exists only in the repository, and the site will not call it available until it ships.</p>
    </div>
    <FrameStrip frames={frames} caption="Meadow Run, a demo whose art and music are all generated in code: the title screen, the world map, Sunny Meadow and Crystal Caves." />
    <ul class="graphics-sockets">
      {graphics.map(item => (
        <Socket as="li" family="graphics" contract={item.contract} module={item.name} note={item.summary} status={socketStatus[item.status]}
          empty={item.status === 'repository' || item.status === 'planned'} />
      ))}
    </ul>
    <p class="more"><a href="/docs/manual/rendering/">Graphics in the manual</a> · <a href="/docs/manual/text/">Text</a></p>
  </section>

  <section class="section wrap" id="platforms" aria-labelledby="platforms-title">
    <div class="split">
      <div class="section-head">
        <p class="label">Platforms</p>
        <h2 id="platforms-title">Six targets from one project</h2>
        <p><code>microengine package</code> turns one game project into what players install on each target, and the game code does not change between them.</p>
        <p><a href="/platforms/">Platforms in detail</a> · <a href="/docs/packaging/">Packaging a game</a></p>
      </div>
      <Platforms />
    </div>
  </section>

  <section class="section wrap" id="demos" aria-labelledby="demos-title">
    <div class="section-head">
      <p class="label">Proof</p>
      <h2 id="demos-title">Four finished games built with it</h2>
      <p>The demos are how MicroEngine checks itself: complete games with a title screen, an ending, saves and achievements, from fully procedural to built from asset files. Each one runs on its page in desktop and mobile browsers, with a keyboard, a gamepad or on-screen touch controls.</p>
    </div>
    <ul class="demo-grid">
      {demoGames.map((game, i) => <li data-reveal style={`--i:${i % 2}`}><DemoCard game={game} loading={i < 2 ? 'eager' : 'lazy'} /></li>)}
    </ul>
    <p class="more"><a href="/demos/">All demos</a></p>
  </section>

  <section class="section wrap" id="status" aria-labelledby="status-title">
    <div class="section-head">
      <p class="label">Status</p>
      <h2 id="status-title">SDK {sdk.stage}, {sdk.version}</h2>
      <p>{sdk.summary}</p>
    </div>
    <div class="ledger">
      {ledger.map(column => (
        <section data-status={socketStatus[column.status]} aria-labelledby={`ledger-${column.status}`}>
          <h3 id={`ledger-${column.status}`}><span class="status-mark" aria-hidden="true"></span>{availabilityLabels[column.status].label}</h3>
          <p class="ledger-meaning">{availabilityLabels[column.status].meaning}</p>
          <p class="ledger-count"><a href="#modules">{column.items.length} {column.items.length === 1 ? 'module' : 'modules'} on the board</a></p>
        </section>
      ))}
    </div>
    <ul class="limits">
      <li><strong>No visual editor.</strong> MicroEngine is code-first; content is code, or files in a content folder.</li>
      <li><strong>iOS is a preview.</strong> Installing on a device needs your Apple developer signing.</li>
      <li><strong>No Android App Bundles yet.</strong> Packages are APKs; Google Play asks for an .aab.</li>
    </ul>
    <p class="more"><a href="/docs/sdk/">Versions and compatibility</a> · <a href="/docs/status/">What it offers today</a></p>
  </section>

  <section class="section wrap" id="start" aria-labelledby="start-title">
    <div class="split">
      <div class="section-head">
        <p class="label">First steps</p>
        <h2 id="start-title">From nothing to a running game</h2>
        <p>{distribution.status}</p>
        <div class="actions">
          <a class="button" href={distribution.startHref}>Install the SDK</a>
          <a class="button secondary" href="/docs/tutorial/">Build your first game</a>
        </div>
      </div>
      <ol class="steps">{distribution.install.map((step, i) => <li data-reveal style={`--i:${i}`}><span class="label">{step.label}</span><code>{step.command}</code></li>)}</ol>
    </div>
  </section>

  <section class="section wrap" id="vision" aria-labelledby="vision-title">
    <div class="vision">
      <div class="section-head">
        <p class="label">Direction</p>
        <h2 id="vision-title">Where it is going</h2>
        <p>MicroEngine began as an engine for 2D pixel-art games, and the demos keep that origin. The direction is a general engine for C#: high-resolution 2D, then 2.5D and 3D, each arriving as modules seated in the same kernel, with tools around the code. That is a direction, not a schedule: on this site, only what ships is called available.</p>
        <p><a href="/roadmap/">Read the roadmap</a></p>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  import { startScroll } from '../scripts/scroll.ts';
  startScroll();
</script>

<style>
  /* Opening: the claim and the drawing side by side on wide screens, then a line of facts across the page. */
  .opening { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-2xl) var(--space-3xl); padding-block: var(--space-2xl) 0; align-items: center; }
  .opening-copy { display: grid; gap: var(--space-lg); min-width: 0; }
  /* The longest word ("orchestrates,") must fit a 320 px screen whole: a smaller ceiling than --text-display. */
  .opening-copy h1 { font-size: var(--text-hero); overflow-wrap: normal; }
  .sdk-line { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2xs) var(--space-sm); font-size: var(--text-sm); color: var(--color-ink-2); }
  .opening-figure { margin: 0; min-width: 0; max-width: 40rem; justify-self: center; width: 100%; }
  .quiet-link { display: inline-flex; align-items: center; min-height: var(--tap); padding-inline: var(--space-xs); font-family: var(--font-mono); font-size: var(--text-sm); }
  .parts-figure { margin: 0; min-width: 0; max-width: 30rem; width: 100%; justify-self: center; }
  .modules-intro { margin-bottom: var(--space-xl); align-items: center; }

  /* The page tape: the page's own progress drawn as the tape of "Every step". A tick where each section starts,
     solid once passed; the amber playhead is the scroll position. It carries no information a reader needs. */
  .page-tape { position: fixed; z-index: 5; inset: 0 0 auto 0; height: var(--space-xs); pointer-events: none; }
  .page-tape :global(.tick) { position: absolute; top: 0; width: var(--rule-pixel); height: var(--space-xs); background: var(--color-ink-4); }
  .page-tape :global(.tick[data-passed]) { background: var(--color-ink); }
  .page-tape .playhead { position: absolute; top: 0; left: calc(var(--at, 0) * 100%); width: calc(var(--rule-pixel) * 3); height: var(--space-sm);
    margin-left: calc(var(--rule-pixel) * -1); background: var(--color-accent-fill); }

  /* Act one is held in place on large screens while the map resolves: the section is taller than the window and its
     content sticks. Nothing takes the scroll over; a reader who keeps scrolling simply leaves. */
  .act-pin { padding-block: var(--space-3xl) 0; }
  @media (min-width: 64rem) and (min-height: 44rem) {
    :global(html.scroll-live) .act-pin { height: 210vh; padding-block: 0; }
    :global(html.scroll-live) .pin-inner { position: sticky; top: 0; min-height: 100vh; display: grid; align-content: center; padding-block: var(--space-2xl); }
  }

  /* The inverted ground: a section drawn in the other theme's colours. It never fades in: its edge travels across
     the page as the section arrives, and travels back when the reader scrolls up. */
  .ground { margin-top: var(--space-3xl); background: var(--color-paper); color: var(--color-ink); }
  .ground-pad { padding-block: var(--space-3xl); }
  .flip { color-scheme: dark; }
  :global(:root[data-theme='dark']) .flip { color-scheme: light; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme='light'])) .flip { color-scheme: light; } }
  :global(html.scroll-live) .ground { clip-path: inset(0 calc((1 - var(--p, 1)) * 100%) 0 0); }

  /* The opening's copy stays; the figure drifts up a little slower than the page as the reader leaves. */
  :global(html.scroll-live) .opening-figure { transform: translateY(calc(var(--p, 0) * var(--space-2xl))); }
  .facts { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1fr); margin: 0;
    border-top: var(--rule-pixel) solid var(--color-ink); }
  .facts div { display: grid; gap: var(--space-2xs); padding: var(--space-sm) 0; border-bottom: var(--rule-thin) solid var(--color-rule); min-width: 0; }
  .facts dt { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-ink-2); text-transform: uppercase; letter-spacing: var(--tracking-label); }
  .facts dd { margin: 0; font-weight: 600; }

  .label { color: var(--color-ink-2); }
  .split { display: grid; gap: var(--space-xl); align-items: start; }
  .split > * { min-width: 0; }
  .split .section-head { margin-bottom: 0; }
  .more { margin-top: var(--space-lg); }

  /* Upstream technologies as credited modules: their names on modules in hairline sockets, never their logos. */
  .credits { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-sm); }
  .credits li { display: grid; gap: var(--space-2xs) var(--space-md); align-items: center; min-width: 0; }
  .credit-socket { display: block; padding: var(--rule-gap); border: var(--rule-thin) solid var(--color-rule); border-radius: var(--radius-sm); }
  .credit-module { display: block; padding: var(--space-xs) var(--space-sm); border: var(--rule-thin) solid var(--color-ink-3);
    border-radius: var(--radius-sm); background: var(--color-paper-2); font-family: var(--font-mono); font-weight: 500; }
  .credit-role { font-size: var(--text-sm); color: var(--color-ink-2); }

  /* The status key under the board: the same marks, written out. */
  .status-key { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-xl); margin: var(--space-md) 0 0; font-size: var(--text-sm); }
  .status-key div { display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-xs); align-items: center; }
  .status-key dt { display: inline-flex; align-items: center; gap: var(--space-xs); font-family: var(--font-mono); font-size: var(--text-xs);
    text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--status-color); }
  .status-key dd { margin: 0; color: var(--color-ink-2); }
  .catalog { margin-top: var(--space-2xl); }
  .catalog h3 { font-family: var(--font-display); font-weight: var(--weight-display); font-size: var(--text-xl); letter-spacing: var(--tracking-display); }

  /* Code panels: graphite in both themes (brand.css), labelled by a CodeLabel strip. */
  .code-surface { margin: 0; min-width: 0; border: var(--rule-thin) solid var(--color-rule); border-radius: var(--radius-sm); overflow: hidden; }
  .code-surface :global(pre) { margin: 0; padding: var(--space-md); overflow-x: auto; font-size: var(--text-xs); line-height: 1.5;
    background: var(--color-paper-2) !important; }
  /* github-dark-dimmed draws comments in a grey under 4.5:1; the panel's quiet ink keeps them readable (WCAG AA). */
  .code-surface :global(span[style*="#768390"]) { color: var(--color-ink-2) !important; }

  .workflow { margin: 0; padding: 0; list-style: none; counter-reset: step; display: grid; gap: var(--space-sm); }
  .workflow li { counter-increment: step; position: relative; padding-left: var(--space-xl); color: var(--color-ink-2); max-width: var(--measure); }
  .workflow li::before { content: counter(step, decimal-leading-zero); position: absolute; left: 0; top: 0.1em;
    font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-ink); padding-top: 2px; border-top: var(--rule-pixel) solid var(--color-ink); }
  .workflow code, .section-head code { font-size: 0.9em; color: var(--color-ink); overflow-wrap: anywhere; }

  .graphics-sockets { list-style: none; margin: var(--space-xl) 0 0; padding: 0; display: grid; gap: var(--space-lg); grid-template-columns: minmax(0, 1fr); }

  .demo-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-lg); grid-template-columns: minmax(0, 1fr); }

  .ledger { display: grid; gap: var(--space-lg); grid-template-columns: minmax(0, 1fr); }
  .ledger section { display: grid; gap: var(--space-sm); align-content: start; padding-top: var(--space-sm); border-top: var(--rule-pixel) solid var(--status-color); min-width: 0; }
  .ledger h3 { display: flex; align-items: center; gap: var(--space-xs); font-family: var(--font-mono); font-weight: 500; font-size: var(--text-xs);
    text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--status-color); }
  .ledger [data-status='repo'] { border-top-style: dashed; }
  .ledger [data-status='planned'] { border-top-style: dotted; }
  .ledger-meaning { font-size: var(--text-sm); color: var(--color-ink-2); }
  .ledger-count { font-family: var(--font-mono); font-size: var(--text-xs); }
  .ledger a { color: var(--color-ink); }
  .limits { margin: var(--space-xl) 0 0; padding: 0; list-style: none; display: grid; gap: var(--space-xs); }
  .limits li { color: var(--color-ink-2); max-width: var(--measure); }
  .limits strong { color: var(--color-ink); font-weight: 600; }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--rule-gap); counter-reset: step; }
  .steps li { counter-increment: step; display: grid; gap: var(--space-2xs); padding: var(--space-sm) var(--space-md); border: var(--rule-thin) solid var(--color-rule);
