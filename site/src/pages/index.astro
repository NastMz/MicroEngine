---
import { Image } from 'astro:assets';
import { Code } from 'astro:components';
import SiteLayout from '../layouts/SiteLayout.astro';
import PixelSprite from '../components/PixelSprite.astro';
import Platforms from '../components/Platforms.astro';
import { demoGames } from '../data/games';
import { excerpt } from '../lib/source.mjs';
import { distribution } from '../data/distribution';

const sample = 'samples/HelloEngine/Program.cs';
const star = excerpt(sample, /var palette = Art\.Palette/, /Atlas = new SpriteAtlasBuilder/);
const scene = excerpt(sample, /public override void Update\(float dt\)/, /_particles\.Update\(dt\)/);

const capabilities = [
  { title: 'Loop and scenes', text: 'Fixed 60 Hz simulation, a scene stack with overlays and transitions, coroutines and tweens.', href: '/docs/manual/lifecycle/' },
  { title: 'Input', text: 'Named actions bound to keys, pad buttons and sticks; scripted input playback for tests and captures.', href: '/docs/manual/input/' },
  { title: 'Pixel graphics', text: 'Procedural images, palettes, noise and dithering; sprite atlases, animation, particles, camera, parallax, light maps and a built-in pixel font.', href: '/docs/manual/rendering/' },
  { title: 'Tile worlds', text: 'Tile layers, swept collision with one-way platforms, autotiling and plain entity lists.', href: '/docs/reference/components/' },
  { title: 'Sound and music', text: 'A retro synthesizer, step-sequencer songs and a mixer, plus WAV effects and streamed OGG/MP3 music.', href: '/docs/manual/audio/' },
  { title: 'Content', text: 'Art and audio as code by default; PNG, WAV and OGG files from a content folder when a game wants them.', href: '/docs/manual/assets/' },
  { title: 'Interface and saves', text: 'Dialogue boxes, menus, JSON saves and achievements with banners and a list screen.', href: '/docs/manual/ui/' },
  { title: 'Testing', text: 'A headless platform for deterministic tests and scripted playthroughs that save PNG captures.', href: '/docs/examples/testing/' },
];
---
<SiteLayout title="MicroEngine" description="A compact, code-first 2D game engine for C#/.NET 10. Four complete pixel-art games run on it, on the desktop and in desktop browsers." current="home">
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">Pixel-art games, written in plain C#.</h1>
      <p class="lede">
        MicroEngine is a compact, code-first 2D engine for .NET 10. Sprites, sounds and scenes are ordinary code,
        and four finished games run on it: on the desktop, and in desktop browsers from the same game code.
      </p>
      <div class="actions">
        <a class="button" href="/demos/">Play the demos</a>
        <a class="button secondary" href="/docs/">Read the docs</a>
      </div>
      <p class="hero-note muted">{distribution.available ? <a href={distribution.startHref}>Get started</a> : <>Not available for download yet · <a href="/roadmap/">See the roadmap</a></>}</p>
    </div>
    <figure class="hero-figure">
      <div class="sprite-code">
        <Code code={star.code} lang="csharp" theme="github-dark-dimmed" />
        <div class="sprite-out">
          <PixelSprite file={sample} scale={14} label="The star sprite drawn from the map on the left" />
          <span class="label">= this sprite</span>
        </div>
      </div>
      <figcaption class="muted">
        A sprite is a palette and a string map. The code is from the engine’s Hello Engine sample, and the sprite is
        drawn here by reading that same file. <a href="/docs/examples/hello-engine/">Walk through the sample</a>
      </figcaption>
    </figure>
  </section>

  <section class="section wrap" id="demos" aria-labelledby="demos-title">
    <div class="section-head">
      <h2 id="demos-title">Four finished games, four genres</h2>
      <p>Each one is a complete game with a title screen, an ending, saves and achievements. They prove what the engine builds today; each has a page with controls, screenshots and a playable browser build.</p>
    </div>
    <ul class="demo-grid">
      {demoGames.map((game, i) => (
        <li class="demo-card" style={`--game: var(${game.colorToken})`}>
          <Image src={game.shots[0].src} alt={game.shots[0].alt} widths={[480, 720, 960]} sizes="(min-width: 64rem) 36rem, 100vw" loading={i < 2 ? 'eager' : 'lazy'} />
          <div class="demo-card-body">
            <p class="label">{game.genre}</p>
            <h3><a href={`/demos/${game.slug}/`}>{game.title}</a></h3>
            <p class="muted">{game.tagline}</p>
            <p class="content-kind"><span class="mono">{game.content.kind}</span> · {game.content.detail}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="section wrap" aria-labelledby="code-title">
    <div class="split">
      <div class="section-head">
        <h2 id="code-title">Actions, not keys</h2>
        <p>Scenes ask for named actions such as <code>confirm</code> or <code>left</code>. Keyboards, gamepads and test scripts all drive the same actions, so an automated playthrough exercises exactly the code a player does.</p>
        <p><a href="/docs/manual/input/">How input works</a></p>
      </div>
      <Code code={scene.code} lang="csharp" theme="github-dark-dimmed" class="code-panel" />
    </div>
  </section>

  <section class="section wrap" aria-labelledby="caps-title">
    <div class="section-head">
      <h2 id="caps-title">What is in the box</h2>
      <p>One backend-independent core library and the systems a small 2D game needs. No editor and no component framework: plain classes you can read.</p>
    </div>
    <dl class="caps">
      {capabilities.map(cap => (
        <div>
          <dt><a href={cap.href}>{cap.title}</a></dt>
          <dd>{cap.text}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section wrap" aria-labelledby="arch-title">
    <div class="section-head">
      <h2 id="arch-title">One game, several platforms</h2>
      <p>The core never references a windowing library. Everything platform-specific sits behind <code>IPlatform</code>, so the same game assembly runs on the desktop, in a browser and in headless tests.</p>
    </div>
    <div class="arch" role="img" aria-label="Layers: games use the MicroEngine core; the core talks to platforms through IPlatform; implementations are raylib on the desktop, raylib compiled to WebAssembly in the browser, and a headless platform for tests.">
      <div class="arch-row">
        {demoGames.map(game => <span class="arch-box game" style={`--game: var(${game.colorToken})`}>{game.title}</span>)}
      </div>
      <div class="arch-link" aria-hidden="true">uses</div>
      <div class="arch-row"><span class="arch-box core"><strong>MicroEngine</strong> core · loop, scenes, input, graphics, world, audio, UI</span></div>
      <div class="arch-link" aria-hidden="true">IPlatform</div>
      <div class="arch-row">
        <span class="arch-box">raylib · desktop window</span>
        <span class="arch-box">raylib · WebAssembly in the browser</span>
        <span class="arch-box">Headless · tests and captures</span>
      </div>
    </div>
    <p class="arch-more"><a href="/docs/architecture/">Read the architecture</a> · <a href="/docs/manual/backends/">Backends and platforms</a></p>
  </section>

  <section class="section wrap" aria-labelledby="platforms-title">
    <div class="section-head">
      <h2 id="platforms-title">Where it runs today</h2>
      <p>Only what has been run is marked as working. Phones and tablets can read this site, but the games have no touch controls.</p>
    </div>
    <Platforms />
  </section>

  <section class="section wrap" aria-labelledby="start-title">
    <div class="split">
      <div class="section-head">
        <h2 id="start-title">Getting MicroEngine</h2>
        <p>{distribution.status}</p>
        <div class="actions">
          {distribution.available
            ? <a class="button" href={distribution.startHref}>Get started</a>
            : <a class="button" href="/roadmap/">See the roadmap</a>}
          <a class="button secondary" href="/docs/getting-started/">Distribution status</a>
        </div>
      </div>
      {distribution.available
        ? <ol class="steps">{distribution.install.map(step => <li><span class="label">{step.label}</span><code>{step.command}</code></li>)}</ol>
        : <ol class="steps">
            <li><span class="label">Today</span><span>Play the four demos in a desktop browser.</span></li>
            <li><span class="label">Today</span><span>Read the manual, the examples and the API reference: they show the engine’s real code.</span></li>
            <li><span class="label">Planned</span><span>NuGet packages and C# project templates, installed without access to the source.</span></li>
            <li><span class="label">Planned</span><span>Free under the MicroEngine SDK License: commercial games allowed, no royalties, your games stay yours. <a href="/docs/licensing/">Licensing</a></span></li>
          </ol>}
    </div>
  </section>

  <section class="section wrap" aria-labelledby="next-title">
    <div class="section-head">
      <h2 id="next-title">Not there yet</h2>
      <p>Things MicroEngine does not have today, so nobody has to find out the hard way.</p>
    </div>
    <ul class="not-yet">
      <li><strong>No public SDK yet.</strong> NuGet packages and project templates are planned, not published.</li>
      <li><strong>No visual editor.</strong> Content is code, or files loaded from a content folder.</li>
      <li><strong>No touch controls.</strong> The browser demos need a keyboard or a gamepad; phones and tablets are not validated.</li>
      <li><strong>Desktop validated on Windows only.</strong> Linux and macOS may work through .NET and raylib, but have not been verified.</li>
    </ul>
    <p class="arch-more"><a href="/roadmap/">What comes next: the roadmap</a> · <a href="/docs/status/">Status and limitations</a></p>
  </section>
</SiteLayout>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-2xl); padding-block: var(--space-3xl) var(--space-xl); align-items: center; }
  .hero-copy { display: grid; gap: var(--space-lg); min-width: 0; }
  .hero-note { font-size: var(--text-sm); }
  .hero-figure { margin: 0; display: grid; gap: var(--space-sm); min-width: 0; }
  .hero-figure figcaption { font-size: var(--text-sm); }
  .sprite-code { display: grid; gap: var(--space-md); border: var(--rule-thin) solid var(--color-rule); background: var(--color-paper-2); padding: var(--space-md); min-width: 0; }
  .sprite-code :global(pre) { margin: 0; overflow-x: auto; font-size: var(--text-xs); line-height: 1.45; background: transparent !important; }
  .sprite-out { display: flex; align-items: center; gap: var(--space-md); }

  .demo-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-lg); grid-template-columns: minmax(0, 1fr); }
  .demo-card { position: relative; display: grid; border: var(--rule-thin) solid var(--color-rule); border-top: 4px solid var(--game);
    background: var(--color-paper-2); transition: transform var(--dur-mid) var(--ease-out), border-color var(--dur-mid) var(--ease-out); }
  .demo-card:hover, .demo-card:focus-within { transform: translateY(-3px); border-color: var(--game); }
  .demo-card img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; image-rendering: pixelated; }
  .demo-card-body { display: grid; gap: var(--space-xs); padding: var(--space-md) var(--space-lg) var(--space-lg); }
  .demo-card h3 { font-family: var(--font-display); font-weight: 500; font-size: var(--text-xl); }
  .demo-card h3 a { color: var(--color-ink); text-decoration: none; }
  .demo-card h3 a::after { content: ''; position: absolute; inset: 0; }
  .demo-card h3 a:focus-visible { outline: none; }
  .demo-card:has(a:focus-visible) { outline: 3px solid var(--color-focus); outline-offset: 3px; }
  .demo-card .label { color: var(--game); }
  .content-kind { font-size: var(--text-sm); color: var(--color-ink-2); }

  .split { display: grid; gap: var(--space-xl); align-items: start; }
  .split > * { min-width: 0; }
  .split .section-head { margin-bottom: 0; }
  :global(.code-panel) { margin: 0; padding: var(--space-md); overflow-x: auto; font-size: var(--text-xs); border: var(--rule-thin) solid var(--color-rule); }

  .caps { display: grid; gap: var(--space-lg) var(--space-xl); grid-template-columns: minmax(0, 1fr); margin: 0; }
  .caps > div { border-top: var(--rule-pixel) solid var(--color-rule); padding-top: var(--space-sm); }
  .caps dt { font-weight: 600; margin-bottom: var(--space-2xs); }
  .caps dt a { color: var(--color-ink); }
  .caps dt a:hover { color: var(--color-accent); }
  .caps dd { margin: 0; color: var(--color-ink-2); font-size: var(--text-sm); }

  .arch { display: grid; gap: var(--space-xs); justify-items: stretch; }
  .arch-row { display: grid; gap: var(--space-xs); grid-template-columns: minmax(0, 1fr); }
  .arch-box { display: block; padding: var(--space-sm) var(--space-md); border: var(--rule-pixel) solid var(--color-rule); background: var(--color-paper-2);
    font-family: var(--font-mono); font-size: var(--text-sm); text-align: center; }
  .arch-box.game { border-color: var(--game); color: var(--game); }
  .arch-box.core { border-color: var(--color-accent); color: var(--color-ink); }
  .arch-box.core strong { color: var(--color-accent); font-weight: 500; }
  .arch-link { justify-self: center; font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-ink-2);
    border-left: var(--rule-pixel) dashed var(--color-rule); padding: var(--space-2xs) 0 var(--space-2xs) var(--space-xs); }
  .arch-more { margin-top: var(--space-lg); }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-sm); counter-reset: step; }
  .steps li { display: grid; gap: var(--space-2xs); padding: var(--space-sm) var(--space-md); border: var(--rule-thin) solid var(--color-rule);
    background: var(--color-paper-2); min-width: 0; }
  .steps code { overflow-x: auto; white-space: nowrap; font-size: var(--text-sm); padding-bottom: var(--space-2xs); }
  .steps span:not(.label) { color: var(--color-ink-2); font-size: var(--text-sm); }

  .not-yet { margin: 0; padding: 0; list-style: none; display: grid; gap: var(--space-sm); grid-template-columns: minmax(0, 1fr); }
  .not-yet li { padding-left: var(--space-lg); position: relative; color: var(--color-ink-2); max-width: var(--measure); }
  .not-yet li::before { content: ''; position: absolute; left: 0; top: 0.6em; width: 8px; height: 8px; background: var(--color-no); }
  .not-yet strong { color: var(--color-ink); font-weight: 600; }

  @media (min-width: 48rem) {
    .demo-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .caps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .arch-row { grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); }
    .not-yet { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 64rem) {
    .hero { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); padding-top: var(--space-4xl); }
    .sprite-code { grid-template-columns: minmax(0, 1fr) auto; align-items: center; }
    .sprite-out { flex-direction: column; }
    .split { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); }
    .caps { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .demo-card:hover, .demo-card:focus-within { transform: none; }
  }
</style>
