---
import SiteLayout from '../layouts/SiteLayout.astro';
import { completed, next, vision, statusLabels, type RoadmapStatus } from '../data/roadmap';

const legend = Object.entries(statusLabels) as [RoadmapStatus, { label: string; meaning: string }][];
---
<SiteLayout title="Roadmap" description="What MicroEngine does today and where it may go next: packages, engine robustness, platform validation, mobile research and a long-term vision. No dates." current="roadmap">
  <div class="wrap roadmap">
    <header class="page-head">
      <h1>Roadmap</h1>
      <p class="lede">What exists today, what comes next and what is only a direction. There are no dates: items move when they are ready, and exploring or vision items may change or be dropped.</p>
      <dl class="legend">
        {legend.map(([key, value]) => (
          <div><dt><span class={`badge ${key}`}>{value.label}</span></dt><dd>{value.meaning}</dd></div>
        ))}
      </dl>
    </header>

    <section aria-labelledby="done-title" class="stage-block">
      <div class="section-head">
        <h2 id="done-title">Available today</h2>
        <p>Everything here runs in the four demos. <a href="/docs/status/">Status and limitations</a> lists what is missing.</p>
      </div>
      <ul class="done-grid">
        {completed.map(item => <li><span class="badge done" aria-hidden="true"></span>{item}</li>)}
      </ul>
    </section>

    <section aria-labelledby="next-title" class="stage-block">
      <div class="section-head">
        <h2 id="next-title">Next stages</h2>
        <p>Work that is intended or being researched. Public installation is the first of them: until it ships, MicroEngine can be seen through its <a href="/demos/">demos</a> and <a href="/docs/">documentation</a>.</p>
      </div>
      <ol class="tracks">
        {next.map(track => (
          <li class={`track ${track.status}`}>
            <div class="track-head">
              <h3>{track.title}</h3>
              <span class={`badge ${track.status}`}>{statusLabels[track.status].label}</span>
            </div>
            <p class="muted">{track.summary}</p>
            <ul>{track.items.map(item => <li>{item}</li>)}</ul>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="vision-title" class="stage-block">
      <div class="section-head">
        <h2 id="vision-title">Future vision</h2>
        <p>Directions, not features. Neither a visual editor nor 3D exists in MicroEngine today.</p>
      </div>
      <ol class="tracks">
        {vision.map(track => (
          <li class={`track ${track.status}`}>
            <div class="track-head">
              <h3>{track.title}</h3>
              <span class={`badge ${track.status}`}>{statusLabels[track.status].label}</span>
            </div>
            <p class="muted">{track.summary}</p>
            <ul>{track.items.map(item => <li>{item}</li>)}</ul>
          </li>
        ))}
      </ol>
    </section>
  </div>
</SiteLayout>

<style>
  .roadmap { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-3xl); padding-top: var(--space-3xl); }
  .page-head { display: grid; gap: var(--space-lg); }
  .legend { margin: 0; display: grid; gap: var(--space-sm); grid-template-columns: minmax(0, 1fr); font-size: var(--text-sm); }
  .legend > div { display: grid; grid-template-columns: 8.5rem minmax(0, 1fr); gap: var(--space-sm); align-items: baseline; }
  .legend dd { margin: 0; color: var(--color-ink-2); }
  .stage-block .section-head { margin-bottom: var(--space-lg); }

  .badge { --tone: var(--color-ink-2); display: inline-flex; align-items: center; gap: var(--space-xs); color: var(--tone);
    font-family: var(--font-mono); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.04em; white-space: nowrap; }
  .badge::before { content: ''; width: 8px; height: 8px; background: var(--tone); }
  .badge.done { --tone: var(--color-ok); }
  .badge.planned { --tone: var(--color-planned); }
  .badge.exploring { --tone: var(--color-exploring); }
  .badge.vision { --tone: var(--color-vision); }
  /* A vision item is hollow: it has no substance yet. */
  .badge.vision::before { background: transparent; outline: var(--rule-pixel) solid var(--tone); outline-offset: -2px; }

  .done-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-xs) var(--space-lg); grid-template-columns: minmax(0, 1fr); }
  .done-grid li { display: flex; align-items: baseline; gap: var(--space-sm); padding: var(--space-xs) 0; border-bottom: var(--rule-thin) solid var(--color-rule); }

  .tracks { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-lg); grid-template-columns: minmax(0, 1fr); }
  .track { --tone: var(--color-rule); display: grid; gap: var(--space-sm); align-content: start; padding: var(--space-lg);
    background: var(--color-paper-2); border: var(--rule-thin) solid var(--color-rule); border-top: 4px solid var(--tone); }
  .track.planned { --tone: var(--color-planned); }
  .track.exploring { --tone: var(--color-exploring); }
  .track.vision { --tone: var(--color-vision); border-style: dashed; border-top-style: solid; background: transparent; }
  .track-head { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-md); align-items: baseline; justify-content: space-between; }
  .track h3 { font-family: var(--font-display); font-weight: 500; font-size: var(--text-xl); }
  .track ul { margin: 0; padding-left: var(--space-lg); display: grid; gap: var(--space-2xs); font-size: var(--text-sm); }
  .track li::marker { color: var(--tone); }

  @media (min-width: 48rem) {
    .legend, .done-grid, .tracks { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
