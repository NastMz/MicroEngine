---
// The roadmap drawn as sockets (site/design/README.md, "Present and future"). Present and future are two separate
// boards: what ships today is a module seated in its socket; what lives only
// in the repository is an empty dashed socket with its name inside; planned work is a dotted outline. The data, every
// item with its family and status, is src/data/roadmap.ts.
import SiteLayout from '../layouts/SiteLayout.astro';
import FamilyIcon from '../components/brand/FamilyIcon.astro';
import { stages, roadmap, next, vision, statusLabels, type RoadmapItem } from '../data/roadmap.ts';
import { availabilityLabels, familyLabels, socketStatus, type Availability } from '../data/capabilities.ts';

const stage = (status: Availability) => stages.find(s => s.status === status)!;
const items = (status: Availability) => roadmap.filter(item => item.status === status);
const tracks = [...next, ...vision].map(track => ({ ...track, items: roadmap.filter(item => item.status === 'planned' && item.track === track.title) }))
  .filter(track => track.items.length);
const seated = (status: Availability) => status === 'available';
const present: Availability[] = ['available'];
const legend = (Object.keys(availabilityLabels) as Availability[]).map(status => ({ status, ...availabilityLabels[status] }));
---
<SiteLayout title="Roadmap" description="What MicroEngine does today, what exists only in the repository, and where it may go next. No dates." current="roadmap">
  <div class="wrap roadmap">
    <header class="roadmap-head">
      <p class="eyebrow">Roadmap</p>
      <h1>Present and future, kept apart.</h1>
      <p class="lede">What you can install today, what exists only in the repository and what is planned. There are no dates: items move when they are ready, and planned items may change or be dropped.</p>
      <ul class="legend" aria-label="How to read the roadmap">
        {legend.map(entry => (
          <li data-status={socketStatus[entry.status]}>
            <span class="legend-bay" data-state={seated(entry.status) ? 'seated' : 'empty'} aria-hidden="true"><span></span></span>
            <span class="legend-text"><strong><span class="status-mark" aria-hidden="true"></span>{entry.label}</strong> {entry.meaning}</span>
          </li>
        ))}
      </ul>
    </header>

    <section class="era" data-era="present" aria-labelledby="present-title">
      <p class="era-rail"><span id="present-title">Present</span><span class="era-note">In the engine: published</span></p>
      {present.map(status => (
        <section class="stage" data-status={socketStatus[status]} aria-labelledby={`stage-${status}`}>
          <div class="stage-head">
            <h2 id={`stage-${status}`}><span class="status-mark" aria-hidden="true"></span>{stage(status).title}</h2>
            <p>{stage(status).summary}</p>
          </div>
          <ul class="bays">
            {items(status).map((item: RoadmapItem) => (
              <li class="bay" data-family={item.family} data-state="seated">
                <span class="module">
                  <span class="family"><FamilyIcon family={item.family} size={14} />{familyLabels[item.family]}</span>
                  <span class="text">{item.text}</span>
                </span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </section>

    <section class="era" data-era="future" aria-labelledby="future-title">
      <p class="era-rail"><span id="future-title">Future</span><span class="era-note">Not in any package: experiments in the repository, and work that is not built</span></p>

      <section class="stage" data-status="repo" aria-labelledby="stage-repository">
        <div class="stage-head">
          <h2 id="stage-repository"><span class="status-mark" aria-hidden="true"></span>{stage('repository').title}</h2>
          <p>{stage('repository').summary}</p>
        </div>
        <ul class="bays">
          {items('repository').map((item: RoadmapItem) => (
            <li class="bay" data-family={item.family} data-state="empty">
              <span class="module">
                <span class="family"><FamilyIcon family={item.family} size={14} mono />{familyLabels[item.family]}</span>
                <span class="text">{item.text}</span>
              </span>
            </li>
          ))}
        </ul>
      </section>

      <section class="stage" data-status="planned" aria-labelledby="stage-planned">
        <div class="stage-head">
          <h2 id="stage-planned"><span class="status-mark" aria-hidden="true"></span>{stage('planned').title}</h2>
          <p>{stage('planned').summary}</p>
          <p>No 3D renderer is published: a minimal 3D path exists only in the repository, and there is no visual editor.</p>
        </div>
        <ol class="tracks">
          {tracks.map(track => (
            <li class="track" data-family={track.family}>
              <div class="track-head">
                <h3><FamilyIcon family={track.family} size={16} mono />{track.title}</h3>
                <span class="horizon">{statusLabels[track.status].label}</span>
              </div>
              <p class="track-summary">{track.summary}</p>
              <ul class="bays planned">
                {track.items.map(item => <li class="bay" data-state="planned"><span class="module"><span class="text">{item.text}</span></span></li>)}
              </ul>
            </li>
          ))}
        </ol>
        <p class="horizons">{(['planned', 'exploring', 'vision'] as const).map(h => <span><strong>{statusLabels[h].label}:</strong> {statusLabels[h].meaning} </span>)}</p>
      </section>
    </section>

    <p class="foot">What a game can rely on today, platform by platform: <a href="/platforms/">Platforms</a>. What is not included: <a href="/docs/reference/limitations/">Requirements and limitations</a>.</p>
  </div>
</SiteLayout>

<style>
  .roadmap { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-3xl); padding-top: var(--space-3xl); }
  .roadmap p { margin: 0; }
  .roadmap-head { display: grid; gap: var(--space-md); max-width: 52rem; }
  .eyebrow { font-family: var(--font-mono); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--color-ink-2); }
  h1 { margin: 0; font-family: var(--font-display); font-weight: var(--weight-display); font-size: var(--text-display);
    letter-spacing: var(--tracking-display); line-height: var(--leading-tight); color: var(--color-ink); }
  .lede { font-size: var(--text-lg); color: var(--color-ink-2); max-width: var(--measure); line-height: var(--leading-body); }

  /* Legend: the four drawings, each with its words. */
  .legend { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-sm); margin: var(--space-sm) 0 0; padding: 0; list-style: none; }
  .legend li { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: var(--space-sm); align-items: start; }
  .legend-bay { display: block; height: 1.75rem; padding: var(--rule-gap); border: var(--rule-thin) solid var(--color-rule); border-radius: var(--radius-sm); }
  .legend-bay span { display: block; height: 100%; border-radius: var(--radius-sm); }
  .legend-bay[data-state='seated'] span { background: color-mix(in oklch, var(--status-color) var(--tint), var(--color-paper)); border: var(--rule-thin) solid var(--status-color); }
  [data-status='repo'] > .legend-bay { border-style: dashed; border-color: var(--color-ink-3); }
  [data-status='planned'] > .legend-bay { border-style: dotted; border-color: var(--color-ink-3); }
  .legend-text { font-size: var(--text-sm); color: var(--color-ink-2); }
  .legend-text strong { display: inline-flex; align-items: center; gap: var(--space-2xs); margin-inline-end: var(--space-2xs);
    color: var(--status-color); font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 500; text-transform: uppercase; letter-spacing: var(--tracking-label); }

  /* An era is a board: a rail with its name, then its stages. The present rail is solid ink; the future rail is dashed. */
  .era { display: grid; gap: var(--space-2xl); }
  .era-rail { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2xs) var(--space-md); padding-top: var(--space-sm);
    border-top: var(--rule-pixel) solid var(--color-ink); }
  [data-era='future'] > .era-rail { border-top-style: dashed; border-top-color: var(--color-ink-3); }
  .era-rail > span:first-child { font-family: var(--font-display); font-weight: var(--weight-display); font-size: var(--text-2xl);
    letter-spacing: var(--tracking-display); line-height: var(--leading-tight); color: var(--color-ink); }
  .era-note { font-family: var(--font-mono); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--color-ink-2); }

  .stage { display: grid; gap: var(--space-md); }
  .stage-head { display: grid; gap: var(--space-xs); max-width: var(--measure); }
  .stage h2 { display: flex; align-items: center; gap: var(--space-xs); margin: 0; font-family: var(--font-body); font-weight: 600;
    font-size: var(--text-lg); line-height: var(--leading-snug); color: var(--status-color); }
  .stage-head p { color: var(--color-ink-2); }

  .bays { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-xs); margin: 0; padding: 0; list-style: none; }
  .bay { min-width: 0; padding: var(--rule-gap); border: var(--rule-thin) solid var(--color-rule); border-radius: var(--radius-sm); background: var(--color-paper); }
  .module { display: grid; gap: var(--space-2xs); height: 100%; box-sizing: border-box; padding: var(--space-xs) var(--space-sm); border-radius: var(--radius-sm); }
  .bay[data-state='seated'] .module { background: color-mix(in oklch, var(--family-color) var(--tint), var(--color-paper));
    border: var(--rule-thin) solid var(--family-color); color: var(--color-ink); transition: transform var(--dur-fast) var(--ease-seat); }
  .bay[data-state='seated']:hover .module { transform: translateY(-2px); }
  .family { display: inline-flex; align-items: center; gap: var(--space-2xs); font-family: var(--font-mono); font-size: var(--text-xs);
    text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--family-color); }
  .text { font-size: var(--text-sm); line-height: var(--leading-snug); }
  /* Not published: the socket is drawn dashed and stays empty; the module is only named, in mono. */
  .bay[data-state='empty'] { border-style: dashed; border-color: var(--color-ink-3); background: transparent; }
  .bay[data-state='empty'] .module { color: var(--color-ink-2); }
  .bay[data-state='empty'] .family { color: var(--color-ink-2); }
  .bay[data-state='empty'] .text { font-family: var(--font-mono); font-size: var(--text-xs); }
  /* Planned: only a dotted outline where a socket may go. */
  .bay[data-state='planned'] { border-style: dotted; border-color: var(--color-ink-3); background: transparent; }
  .bay[data-state='planned'] .module { padding-block: var(--space-2xs); color: var(--color-ink-2); }

  .tracks { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); margin: 0; padding: 0; list-style: none; }
  .track { display: grid; gap: var(--space-xs); align-content: start; min-width: 0; }
  .track-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2xs) var(--space-md); }
  .track h3 { display: inline-flex; align-items: center; gap: var(--space-xs); margin: 0; font-family: var(--font-display);
    font-weight: var(--weight-display); font-size: var(--text-xl); letter-spacing: var(--tracking-display); line-height: var(--leading-snug); color: var(--color-ink); }
  .horizon { font-family: var(--font-mono); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--status-planned); }
  .track-summary { font-size: var(--text-sm); color: var(--color-ink-2); }
  .horizons { display: grid; gap: var(--space-2xs); font-size: var(--text-sm); color: var(--color-ink-2); max-width: var(--measure); }
  .horizons strong { color: var(--color-ink); font-weight: 600; }
  .foot { font-size: var(--text-sm); color: var(--color-ink-2); }
  .roadmap a { color: var(--color-accent); }

  @media (min-width: 40rem) {
    .bays { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .legend { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 64rem) {
    .bays { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .tracks { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tracks .bays { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .bay[data-state='seated'] .module { transition: none; }
    .bay[data-state='seated']:hover .module { transform: none; }
  }
</style>
