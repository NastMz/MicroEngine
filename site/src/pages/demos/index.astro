---
// The demos index: four finished games presented as proof that the engine works, each a DemoCard with the engine
// features it exercises (components/demos/exercises.mjs). The product is MicroEngine; the games show what it runs.
import SiteLayout from '../../layouts/SiteLayout.astro';
import DemoCard from '../../components/DemoCard.astro';
import Exercises from '../../components/demos/Exercises.astro';
import FamilyIcon from '../../components/brand/FamilyIcon.astro';
import { demoGames } from '../../data/games';
import { playManifest, megabytes } from '../../lib/play-manifest.mjs';
import { targets } from '../../lib/versions.mjs';

const manifest = playManifest();
// Systems with a released package, in targets.json order: the copy never names a download that does not exist.
const systems = targets.filter(t => Object.values(manifest?.downloads ?? {}).some(byTarget => byTarget[t.id]?.url)).map(t => t.label);
const where = systems.length ? ` or download them for ${systems.join(', ')}` : '';
const legend = [
  ['kernel', 'Kernel'], ['graphics', 'Graphics'], ['physics', 'Physics'], ['audio', 'Audio'], ['input', 'Input'],
] as const;
---
<SiteLayout title="Demos" description={`Play the four MicroEngine demo games in a browser${where}: a platformer, an action adventure, a creature-collecting RPG and a run & gun.`} current="demos">
  <div class="wrap demos-page">
    <header class="page-head">
      <p class="eyebrow">Proof, built with MicroEngine</p>
      <h1>The demos</h1>
      <p class="lede">Four complete games written in C# on MicroEngine, each with a title screen, an ending, saves and achievements. The same game code runs in the browser (WebAssembly){systems.length ? <> and as downloads for {systems.join(', ')}</> : null}. Each page loads its game only when you press Play.</p>
      <p class="notice"><span class="verdict ok">In the browser</span><span>The web builds play with a keyboard, a gamepad or on-screen touch controls. They are tested in Chrome and Firefox on desktop and on emulated phones and tablets.</span></p>
    </header>

    <section class="proof" aria-labelledby="proof-title">
      <div class="proof-head">
        <h2 id="proof-title">What each game exercises</h2>
        <p>The markers name the engine features a game's code calls, by module family:
          {legend.map(([family, name], i) => <span class="key" data-family={family}><FamilyIcon family={family} size={12} />{name}{i < legend.length - 1 ? ',' : '.'}</span>)}
        </p>
      </div>
      <ul class="grid">
        {demoGames.map((game, i) => (
          <li>
            <DemoCard game={game} shot={1} heading="h3" loading={i < 2 ? 'eager' : 'lazy'} sizes="(min-width: 76rem) 36rem, (min-width: 48rem) 50vw, 100vw">
              <Exercises game={game.id} compact />
              {manifest?.games?.[game.id] && <p class="size">Browser download: about {megabytes(manifest.games[game.id].transfer)}</p>}
            </DemoCard>
          </li>
        ))}
      </ul>
    </section>

    <p class="foot">The games are all rights reserved; the engine that runs them is <a href="/docs/licensing/">MIT licensed</a>. To make your own, start with <a href="/docs/tutorial/">the tutorial</a>.</p>
  </div>
</SiteLayout>

<style>
  .demos-page { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-2xl); padding-block: var(--space-3xl) var(--space-xl); }
  .demos-page p { margin: 0; }
  .page-head { display: grid; gap: var(--space-md); max-width: 52rem; }
  .eyebrow { font-family: var(--font-mono); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: var(--tracking-label); color: var(--color-ink-2); }
  .lede { max-width: var(--measure); line-height: var(--leading-body); }
  .notice { display: grid; gap: var(--space-2xs); padding: var(--space-sm) var(--space-md); max-width: var(--measure);
    border-left: var(--rule-pixel) solid var(--color-ok); background: var(--color-paper-2); color: var(--color-ink-2); font-size: var(--text-sm); }
  .verdict { display: inline-flex; align-items: center; gap: var(--space-2xs); font-family: var(--font-mono); font-size: var(--text-xs);
    text-transform: uppercase; letter-spacing: var(--tracking-label); white-space: nowrap; }
  .verdict::before { content: ''; width: 0.625rem; height: 0.625rem; background: currentColor; }
  .verdict.ok { color: var(--color-ok); }

  /* The cards sit under a rail, like the modules of the platforms page. */
  .proof { display: grid; gap: var(--space-lg); padding-top: var(--space-md); border-top: var(--rule-pixel) solid var(--color-ink); }
  .proof-head { display: grid; gap: var(--space-xs); }
  .proof-head h2 { font-size: var(--text-xl); line-height: var(--leading-snug); }
  .proof-head p { font-size: var(--text-sm); color: var(--color-ink-2); max-width: var(--measure); }
  .key { display: inline-flex; align-items: center; gap: var(--space-2xs); margin-inline-start: var(--space-xs); color: var(--color-ink); white-space: nowrap; }
  .key :global(.family-icon) { color: var(--color-ink); }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-lg); margin: 0; padding: 0; list-style: none; }
  .grid > li { min-width: 0; }
  .grid :global(.exercises) { margin-top: var(--space-2xs); }
  .size { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-ink-2); }
  .foot { font-size: var(--text-sm); color: var(--color-ink-2); max-width: var(--measure); }
  .foot a, .notice a { color: var(--color-accent); }
  @media (min-width: 48rem) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 64rem) {
    .proof { grid-template-columns: 16rem minmax(0, 1fr); column-gap: var(--space-xl); }
    .proof-head { align-content: start; }
  }
</style>
