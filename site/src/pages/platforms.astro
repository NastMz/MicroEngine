---
// The supported platforms (src/data/platforms.ts): how a game runs on each, where it is built, what players need and
// what to plan around. The developer guide is docs/guide/platforms.md.
import SiteLayout from '../layouts/SiteLayout.astro';
import { platforms, supportLabels } from '../data/platforms';
import { targets } from '../lib/versions.mjs';
import { playManifest } from '../lib/play-manifest.mjs';

const downloads = playManifest()?.downloads ?? {};
const released = new Set(Object.values(downloads).flatMap(byTarget => Object.keys(byTarget)));
const rows = (row: (typeof platforms)[number]) => [
  ['Runs on', row.runtime], ['Build', row.build], ['Players need', row.requires], ['Input', row.input], ['Plan for', row.notes],
] as const;
---
<SiteLayout title="Platforms" description="Where MicroEngine games run: Windows, Linux, macOS, Android, iOS and web browsers, from one game project, and what each platform needs." current="platforms">
  <div class="wrap page">
    <header class="page-head">
      <h1>Platforms</h1>
      <p class="lede">One game project, six targets. The game's code is the same everywhere; the platform underneath is SDL 3 on desktops and phones and raylib in browsers, and <code>microengine package</code> builds what players install.</p>
    </header>

    {platforms.map(row => {
      const target = 'target' in row.download ? targets.find(t => t.id === (row.download as { target: string }).target) : null;
      return (
        <section class="platform" id={row.id} aria-labelledby={`${row.id}-title`}>
          <div class="platform-head">
            <h2 id={`${row.id}-title`}>{row.name}</h2>
            <span class={`status ${row.support === 'supported' ? 'ok' : 'partial'}`}>{supportLabels[row.support]}</span>
          </div>
          <dl class="facts">
            {rows(row).map(([name, value]) => <div><dt>{name}</dt><dd>{value}</dd></div>)}
          </dl>
          <p class="small muted">
            {target
              ? (released.has(target.id) ? <>The demos: <a href="/docs/downloads/">{target.detail} downloads</a>.</> : <>The demos: no {target.label} download in the current release.</>)
              : row.download.none}
          </p>
        </section>
      );
    })}

    <p class="muted small">Building for a platform: <a href="/docs/platforms/">Platforms guide</a> · <a href="/docs/packaging/">Packaging a game</a> · <a href="/docs/signing/">Signing</a>.</p>
  </div>
</SiteLayout>

<style>
  .page { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-2xl); padding-top: var(--space-3xl); }
  .page-head { display: grid; gap: var(--space-lg); }
  .small { font-size: var(--text-sm); }
  .platform { display: grid; gap: var(--space-sm); padding-top: var(--space-lg); border-top: var(--rule-pixel) solid var(--color-rule); scroll-margin-top: var(--space-lg); }
  .platform-head { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-md); align-items: baseline; }
  .facts { margin: 0; display: grid; gap: var(--space-xs); grid-template-columns: minmax(0, 1fr); }
  .facts > div { display: grid; gap: var(--space-2xs); padding: var(--space-sm); background: var(--color-paper-2); border: var(--rule-thin) solid var(--color-rule); min-width: 0; }
  .facts dt { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-ink-2); text-transform: uppercase; letter-spacing: 0.04em; }
  .facts dd { margin: 0; font-size: var(--text-sm); }
  @media (min-width: 40rem) { .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .facts { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
