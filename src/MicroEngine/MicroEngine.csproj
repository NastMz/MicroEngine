<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>MicroEngine</RootNamespace>
    <Description>Backend-independent core of the MicroEngine 2D game engine: loop, scenes, input actions, graphics model, audio synthesis, UI, saves, achievements, a headless platform, and the build targets that give a game its application identity.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MicroEngine.Tests" />
  </ItemGroup>
  <!-- The kernel (composition, schedule, time, math and colour) is its own assembly but not its own package: this
       package carries MicroEngine.Kernel.dll with its documentation and symbols, and depends on no MicroEngine.Kernel
       package. The reference is private (so packing adds no dependency on it); inside the repository, projects that
       reference this one still compile against the kernel and copy it, because this project hands the kernel's
       assembly over together with its own (_MicroEngineKernelOutput). -->
  <ItemGroup>
    <ProjectReference Include="../MicroEngine.Kernel/MicroEngine.Kernel.csproj" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="_MicroEngineKernelOutput">
    <MSBuild Projects="../MicroEngine.Kernel/MicroEngine.Kernel.csproj" Targets="GetTargetPath" Properties="BuildProjectReferences=false">
      <Output TaskParameter="TargetOutputs" ItemName="_MicroEngineKernelAssembly" />
    </MSBuild>
  </Target>
  <Target Name="_MicroEngineExportKernel" AfterTargets="GetTargetPathWithTargetPlatformMoniker" DependsOnTargets="_MicroEngineKernelOutput">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker Include="@(_MicroEngineKernelAssembly)" />
    </ItemGroup>
  </Target>
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);_MicroEngineBundleKernel</TargetsForTfmSpecificBuildOutput>
    <TargetsForTfmSpecificDebugSymbolsInPackage>$(TargetsForTfmSpecificDebugSymbolsInPackage);_MicroEngineBundleKernelSymbols</TargetsForTfmSpecificDebugSymbolsInPackage>
  </PropertyGroup>
  <Target Name="_MicroEngineBundleKernel" DependsOnTargets="_MicroEngineKernelOutput">
    <ItemGroup>
      <BuildOutputInPackage Include="@(_MicroEngineKernelAssembly);@(_MicroEngineKernelAssembly->'%(RootDir)%(Directory)%(Filename).xml')" />
    </ItemGroup>
  </Target>
  <Target Name="_MicroEngineBundleKernelSymbols" DependsOnTargets="_MicroEngineKernelOutput">
    <ItemGroup>
      <TfmSpecificDebugSymbolsFile Include="@(_MicroEngineKernelAssembly->'%(RootDir)%(Directory)%(Filename).pdb')">
        <TargetPath>MicroEngine.Kernel.pdb</TargetPath>
        <TargetFramework>$(TargetFramework)</TargetFramework>
      </TfmSpecificDebugSymbolsFile>
    </ItemGroup>
  </Target>
  <!-- Managed and permissively licensed (ADR 0025, THIRD-PARTY-NOTICES.md): image decoding (StbImageSharp) and scalable
       fonts (FontStashSharp over StbTrueTypeSharp). No native code, so every platform and headless tests decode alike. -->
  <ItemGroup>
    <PackageReference Include="StbImageSharp" Version="[2.30.15]" />
    <PackageReference Include="FontStashSharp" Version="[1.3.10]" />
  </ItemGroup>
  <!-- The application-identity targets (build/MicroEngine.targets) apply to every game that references the package,
       directly or through a backend package. -->
  <ItemGroup>
    <None Include="build/MicroEngine.targets" Pack="true" PackagePath="build/;buildTransitive/" />
  </ItemGroup>
  <!-- The package also says which SDK version it is, for `microengine` and for build-info files. -->
  <Target Name="_MicroEngineVersionProps" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_MicroEngineVersionProps>$(IntermediateOutputPath)MicroEngine.props</_MicroEngineVersionProps>
    </PropertyGroup>
    <WriteLinesToFile File="$(_MicroEngineVersionProps)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="&lt;Project&gt;&lt;PropertyGroup&gt;&lt;MicroEngineVersion Condition=&quot;'%24(MicroEngineVersion)' == ''&quot;&gt;$(Version)&lt;/MicroEngineVersion&gt;&lt;/PropertyGroup&gt;&lt;/Project&gt;" />
    <ItemGroup>
      <None Include="$(_MicroEngineVersionProps)" Pack="true" PackagePath="build/;buildTransitive/" />
    </ItemGroup>
  </Target>
</Project>
