<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>MicroEngine</RootNamespace>
    <Description>Backend-independent core of the MicroEngine 2D game engine: loop, scenes, input actions, graphics model, audio synthesis, UI, saves, achievements, a headless platform, and the build targets that give a game its application identity.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MicroEngine.Tests" />
  </ItemGroup>
  <!-- The kernel (composition, schedule, time, math and colour) and the platform contracts (host, surface, storage,
       content sources) are assemblies of their own but not packages: this package carries MicroEngine.Kernel.dll and
       MicroEngine.Platform.dll with their documentation and symbols, and depends on no package of theirs. The
       references are private (so packing adds no dependency on them); inside the repository, projects that reference
       this one still compile against them and copy them, because this project hands their assemblies over together
       with its own (_MicroEngineBundledOutput). -->
  <ItemGroup>
    <ProjectReference Include="../MicroEngine.Kernel/MicroEngine.Kernel.csproj" PrivateAssets="all" />
    <ProjectReference Include="../MicroEngine.Platform/MicroEngine.Platform.csproj" PrivateAssets="all" />
    <_MicroEngineBundledProject Include="../MicroEngine.Kernel/MicroEngine.Kernel.csproj;../MicroEngine.Platform/MicroEngine.Platform.csproj" />
  </ItemGroup>
  <Target Name="_MicroEngineBundledOutput">
    <MSBuild Projects="@(_MicroEngineBundledProject)" Targets="GetTargetPath" Properties="BuildProjectReferences=false">
      <Output TaskParameter="TargetOutputs" ItemName="_MicroEngineBundledAssembly" />
    </MSBuild>
  </Target>
  <Target Name="_MicroEngineExportBundled" AfterTargets="GetTargetPathWithTargetPlatformMoniker" DependsOnTargets="_MicroEngineBundledOutput">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker Include="@(_MicroEngineBundledAssembly)" />
    </ItemGroup>
  </Target>
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);_MicroEngineBundle</TargetsForTfmSpecificBuildOutput>
    <TargetsForTfmSpecificDebugSymbolsInPackage>$(TargetsForTfmSpecificDebugSymbolsInPackage);_MicroEngineBundleSymbols</TargetsForTfmSpecificDebugSymbolsInPackage>
  </PropertyGroup>
  <Target Name="_MicroEngineBundle" DependsOnTargets="_MicroEngineBundledOutput">
    <ItemGroup>
      <BuildOutputInPackage Include="@(_MicroEngineBundledAssembly);@(_MicroEngineBundledAssembly->'%(RootDir)%(Directory)%(Filename).xml')" />
    </ItemGroup>
  </Target>
  <Target Name="_MicroEngineBundleSymbols" DependsOnTargets="_MicroEngineBundledOutput">
    <ItemGroup>
      <TfmSpecificDebugSymbolsFile Include="@(_MicroEngineBundledAssembly->'%(RootDir)%(Directory)%(Filename).pdb')">
        <TargetPath>%(Filename).pdb</TargetPath>
        <TargetFramework>$(TargetFramework)</TargetFramework>
      </TfmSpecificDebugSymbolsFile>
    </ItemGroup>
  </Target>
  <!-- Managed and permissively licensed (ADR 0025, THIRD-PARTY-NOTICES.md): image decoding (StbImageSharp) and scalable
       fonts (FontStashSharp over StbTrueTypeSharp). No native code, so every platform and headless tests decode alike. -->
  <ItemGroup>
    <PackageReference Include="StbImageSharp" Version="[2.30.15]" />
    <PackageReference Include="FontStashSharp" Version="[1.3.10]" />
  </ItemGroup>
  <!-- The application-identity targets (build/MicroEngine.targets) apply to every game that references the package,
       directly or through a backend package. -->
  <ItemGroup>
    <None Include="build/MicroEngine.targets" Pack="true" PackagePath="build/;buildTransitive/" />
  </ItemGroup>
  <!-- The package also says which SDK version it is, for `microengine` and for build-info files. -->
  <Target Name="_MicroEngineVersionProps" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_MicroEngineVersionProps>$(IntermediateOutputPath)MicroEngine.props</_MicroEngineVersionProps>
    </PropertyGroup>
    <WriteLinesToFile File="$(_MicroEngineVersionProps)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="&lt;Project&gt;&lt;PropertyGroup&gt;&lt;MicroEngineVersion Condition=&quot;'%24(MicroEngineVersion)' == ''&quot;&gt;$(Version)&lt;/MicroEngineVersion&gt;&lt;/PropertyGroup&gt;&lt;/Project&gt;" />
    <ItemGroup>
      <None Include="$(_MicroEngineVersionProps)" Pack="true" PackagePath="build/;buildTransitive/" />
    </ItemGroup>
  </Target>
</Project>
