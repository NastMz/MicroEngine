<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>MicroEngine</RootNamespace>
    <Description>Backend-independent core of the MicroEngine 2D game engine: loop, scenes, input (device events, players, actions), graphics model, audio synthesis, UI, saves, achievements, a headless platform, and the build targets that give a game its application identity.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MicroEngine.Tests" />
  </ItemGroup>
  <!-- The kernel (composition, schedule, time, math and colour), the platform contracts (host, surface, storage,
       content sources), the graphics device contract (devices, resources, command lists, the reference
       device), the 2D layer over it (batcher, camera), input (device events, players, layers, actions), hosting (the launcher model and the
       composition a game configures), content (the asset store, handles, loaders and content sources) and audio (the
       mixer over PCM sinks) are assemblies of their own but not packages: this package carries MicroEngine.Kernel.dll,
       MicroEngine.Platform.dll, MicroEngine.Graphics.dll, MicroEngine.Graphics2D.dll, MicroEngine.Input.dll, the touch controls MicroEngine.Input.Touch.dll, MicroEngine.Hosting.dll, MicroEngine.Content.dll and
       MicroEngine.Audio.dll, the scene world (ids, transforms, attachments) MicroEngine.Scene.dll, and physics (the 2D
       contract MicroEngine.Physics.dll and the tile backend with the tile types MicroEngine.Physics.Tiles.dll) saves (MicroEngine.Saves.dll) text (fonts, MicroEngine.Text.dll), the UI (widgets, MicroEngine.UI.dll) and achievements (MicroEngine.Achievements.dll), with their documentation and symbols, and depends on no package of theirs. The references
       are private (so packing adds no dependency on them); inside the repository, projects that reference this one
       still compile against them and copy them, because this project hands their assemblies over together with its
       own (_MicroEngineBundledOutput). -->
  <ItemGroup>
    <ProjectReference Include="../MicroEngine.Kernel/MicroEngine.Kernel.csproj" PrivateAssets="all" />
    <ProjectReference Include="../MicroEngine.Platform/MicroEngine.Platform.csproj" PrivateAssets="all" />
    <ProjectReference Include="../MicroEngine.Graphics/MicroEngine.Graphics.csproj" PrivateAssets="all" />
    <ProjectReference Include="../MicroEngine.Graphics2D/MicroEngine.Graphics2D.csproj" PrivateAssets="all" />
    <ProjectReference Include="../MicroEngine.Input/MicroEngine.Input.csproj" PrivateAssets="all" />
    <ProjectReference Include="../MicroEngine.Input.Touch/MicroEngine.Input.Touch.csproj" PrivateAssets="all" />
    <ProjectReference Include="../MicroEngine.Hosting/MicroEngine.Hosting.csproj" PrivateAssets="all" />
    <ProjectReference Include="../MicroEngine.Content/MicroEngine.Content.csproj" PrivateAssets="all" />
    <ProjectReference Include="../MicroEngine.Audio/MicroEngine.Audio.csproj" PrivateAssets="all" />
    <ProjectReference Include="../MicroEngine.Scene/MicroEngine.Scene.csproj" PrivateAssets="all" />
    <ProjectReference Include="../MicroEngine.Physics/MicroEngine.Physics.csproj" PrivateAssets="all" />
    <ProjectReference Include="../MicroEngine.Physics.Tiles/MicroEngine.Physics.Tiles.csproj" PrivateAssets="all" />
    <ProjectReference Include="../MicroEngine.Saves/MicroEngine.Saves.csproj" PrivateAssets="all" />
    <ProjectReference Include="../MicroEngine.Text/MicroEngine.Text.csproj" PrivateAssets="all" />
    <ProjectReference Include="../MicroEngine.Achievements/MicroEngine.Achievements.csproj" PrivateAssets="all" />
    <ProjectReference Include="../MicroEngine.UI/MicroEngine.UI.csproj" PrivateAssets="all" />
    <_MicroEngineBundledProject Include="../MicroEngine.Kernel/MicroEngine.Kernel.csproj;../MicroEngine.Platform/MicroEngine.Platform.csproj;../MicroEngine.Graphics/MicroEngine.Graphics.csproj;../MicroEngine.Graphics2D/MicroEngine.Graphics2D.csproj;../MicroEngine.Input/MicroEngine.Input.csproj;../MicroEngine.Input.Touch/MicroEngine.Input.Touch.csproj;../MicroEngine.Hosting/MicroEngine.Hosting.csproj;../MicroEngine.Content/MicroEngine.Content.csproj;../MicroEngine.Audio/MicroEngine.Audio.csproj;../MicroEngine.Scene/MicroEngine.Scene.csproj;../MicroEngine.Physics/MicroEngine.Physics.csproj;../MicroEngine.Physics.Tiles/MicroEngine.Physics.Tiles.csproj;../MicroEngine.Saves/MicroEngine.Saves.csproj;../MicroEngine.Text/MicroEngine.Text.csproj;../MicroEngine.Achievements/MicroEngine.Achievements.csproj;../MicroEngine.UI/MicroEngine.UI.csproj" />
  </ItemGroup>
  <Target Name="_MicroEngineBundledOutput">
    <MSBuild Projects="@(_MicroEngineBundledProject)" Targets="GetTargetPath" Properties="BuildProjectReferences=false">
      <Output TaskParameter="TargetOutputs" ItemName="_MicroEngineBundledAssembly" />
    </MSBuild>
  </Target>
  <Target Name="_MicroEngineExportBundled" AfterTargets="GetTargetPathWithTargetPlatformMoniker" DependsOnTargets="_MicroEngineBundledOutput">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker Include="@(_MicroEngineBundledAssembly)" />
    </ItemGroup>
  </Target>
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);_MicroEngineBundle</TargetsForTfmSpecificBuildOutput>
    <TargetsForTfmSpecificDebugSymbolsInPackage>$(TargetsForTfmSpecificDebugSymbolsInPackage);_MicroEngineBundleSymbols</TargetsForTfmSpecificDebugSymbolsInPackage>
  </PropertyGroup>
  <Target Name="_MicroEngineBundle" DependsOnTargets="_MicroEngineBundledOutput">
    <ItemGroup>
      <BuildOutputInPackage Include="@(_MicroEngineBundledAssembly);@(_MicroEngineBundledAssembly->'%(RootDir)%(Directory)%(Filename).xml')" />
    </ItemGroup>
  </Target>
  <Target Name="_MicroEngineBundleSymbols" DependsOnTargets="_MicroEngineBundledOutput">
    <ItemGroup>
      <TfmSpecificDebugSymbolsFile Include="@(_MicroEngineBundledAssembly->'%(RootDir)%(Directory)%(Filename).pdb')">
        <TargetPath>%(Filename).pdb</TargetPath>
        <TargetFramework>$(TargetFramework)</TargetFramework>
      </TfmSpecificDebugSymbolsFile>
    </ItemGroup>
  </Target>
  <!-- Managed and permissively licensed (ADR 0025, THIRD-PARTY-NOTICES.md): image decoding (StbImageSharp) and scalable
       fonts (FontStashSharp over StbTrueTypeSharp). No native code, so every platform and headless tests decode alike.
       The bundled 2D assembly (MicroEngine.Graphics2D, PixelImage) decodes images and the bundled text assembly
       (MicroEngine.Text, ScalableFont) rasterizes fonts; the references here make StbImageSharp and FontStashSharp
       dependencies of the MicroEngine package, which carries those assemblies. -->
  <ItemGroup>
    <PackageReference Include="StbImageSharp" Version="[2.30.15]" />
    <PackageReference Include="FontStashSharp" Version="[1.3.10]" />
    <!-- The bundled audio assembly decodes OGG Vorbis music (NVorbis, managed, MIT). -->
    <PackageReference Include="NVorbis" Version="[0.10.5]" />
  </ItemGroup>
  <!-- The application-identity targets (build/MicroEngine.targets) apply to every game that references the package,
       directly or through a backend package. -->
  <ItemGroup>
    <None Include="build/MicroEngine.targets" Pack="true" PackagePath="build/;buildTransitive/" />
  </ItemGroup>
  <!-- The package also says which SDK version it is, for `microengine` and for build-info files. -->
  <Target Name="_MicroEngineVersionProps" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_MicroEngineVersionProps>$(IntermediateOutputPath)MicroEngine.props</_MicroEngineVersionProps>
    </PropertyGroup>
    <WriteLinesToFile File="$(_MicroEngineVersionProps)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="&lt;Project&gt;&lt;PropertyGroup&gt;&lt;MicroEngineVersion Condition=&quot;'%24(MicroEngineVersion)' == ''&quot;&gt;$(Version)&lt;/MicroEngineVersion&gt;&lt;/PropertyGroup&gt;&lt;/Project&gt;" />
    <ItemGroup>
      <None Include="$(_MicroEngineVersionProps)" Pack="true" PackagePath="build/;buildTransitive/" />
    </ItemGroup>
  </Target>
</Project>
