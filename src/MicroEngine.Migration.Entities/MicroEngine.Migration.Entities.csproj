<Project Sdk="Microsoft.NET.Sdk">
  <!-- TRANSITIONAL. The legacy Entity/EntityList<T> API rebuilt over IWorld (MicroEngine.Scene), so the four demos keep
       compiling while they migrate to Scene.Objects. Never packed, never part of an engine package, consumed only by the
       demos (and its own tests): the architecture test fails on any other reference. Every type is [Obsolete] with the
       diagnostic MEMIG001. Deleted at the end of ARCH-1 stage 5. It references the core (MicroEngine) because the legacy
       Draw(IRenderer) signature uses the IRenderer facade, which still lives there. -->
  <PropertyGroup>
    <RootNamespace>MicroEngine.World</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;MEMIG001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MicroEngine.Scene/MicroEngine.Scene.csproj" />
    <ProjectReference Include="../MicroEngine.Graphics2D/MicroEngine.Graphics2D.csproj" />
    <ProjectReference Include="../MicroEngine.Kernel/MicroEngine.Kernel.csproj" />
    <ProjectReference Include="../MicroEngine/MicroEngine.csproj" />
  </ItemGroup>
</Project>
