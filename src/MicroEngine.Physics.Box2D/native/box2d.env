# The Box2D release MicroEngine.Physics.Box2D is built from (read by build.sh). The tag must resolve to the commit:
# the commit id is the checksum of the source tree, so a moved tag fails the build instead of changing the physics.
# Updating Box2D is deliberate: change both lines, rebuild every runtime identifier and re-run the physics suites
# (Box2D v3 changes its API between minor versions, and results differ between versions from the first step).
BOX2D_REPO=https://github.com/erincatto/box2d.git
BOX2D_TAG=v3.2.0
BOX2D_COMMIT=178495ba35695aefe9c321e569d2277f06db3b90
# The Android NDK CI builds android-* with (build.sh takes whatever ANDROID_NDK points at locally).
ANDROID_NDK_VERSION=27.3.13750724
