<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!-- Browser host of `microengine package web` (docs/guide/packaging.md): the game runs on SDL 3 compiled to
       WebAssembly; wwwroot/main.js is the page bridge. `microengine` copies this
       folder into the game's obj folder and writes Game.props, GameEntry.cs, game.json and content.txt. Needs the
       wasm-tools workload. -->
  <Import Project="Game.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AssemblyName>$(GameId).Web</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmBuildNative>true</WasmBuildNative>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <!-- SaveStore serializes game types with reflection-based System.Text.Json: trim only framework assemblies (and the
         native bindings below). The trimmer's warnings about those two calls (IL2026/IL3050) are known. -->
    <TrimMode>partial</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <NoWarn>$(NoWarn);IL2026;IL3050</NoWarn>
    <!-- No ICU data: a smaller download, and output that never depends on the visitor's language. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(GameProject)" />
    <!-- Game files served next to the page: the page copies Content into the runtime's file system at /Content before
         the game starts, so ContentFolder reads them exactly as on desktop. -->
    <Content Include="$(GameContentDir)**" Exclude="$(GameContentDir)**/*.cs" Link="wwwroot/Content/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" Condition="'$(GameContentDir)' != ''" />
    <Content Include="$(GameScriptsDir)*.script" Link="wwwroot/scripts/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" Condition="'$(GameScriptsDir)' != '' and '$(WebDevHooks)' == 'true'" />
  </ItemGroup>

  <!-- SDL 3: SDL3.a built with the workload's own emscripten (src/MicroEngine.Sdl/native/build.sh), from the
       MicroEngine.Sdl package or web/setup.sh's. SDL_Renderer's OpenGL ES 2 driver draws on WebGL. The bindings are
       trimmed, so only the SDL functions the engine calls reach the native link (SDL3-CS declares about 1300); a game
       that also references raylib (MicroEngine.Desktop) keeps none of it. -->
  <PropertyGroup>
    <EmccExtraLDFlags>$(EmccExtraLDFlags) -sMAX_WEBGL_VERSION=2</EmccExtraLDFlags>
  </PropertyGroup>
  <ItemGroup>
    <TrimmableAssembly Include="SDL3-CS" />
    <TrimmableAssembly Include="Raylib-cs" />
    <TrimmableAssembly Include="MicroEngine.Raylib" />
  </ItemGroup>
  <Target Name="_UseWorkloadSdl" BeforeTargets="_PrepareForBrowserWasmBuildNative">
    <Error Condition="!Exists('$(SdlWasmLib)')" Text="SDL for the web is missing ($(SdlWasmLib)). It comes with the MicroEngine.Sdl package; in a MicroEngine checkout run web/setup.sh, or pass --sdl-wasm &lt;path&gt;." />
    <PropertyGroup>
      <!-- Raylib-cs adds GLFW's JavaScript for raylib; the page has no raylib. -->
      <EmccFlags>$(EmccFlags.Replace('-sUSE_GLFW=3', ''))</EmccFlags>
    </PropertyGroup>
    <ItemGroup>
      <!-- Raylib-cs's own browser raylib.a, which nothing calls. -->
      <NativeFileReference Remove="@(NativeFileReference)" Condition="'%(Filename)' == 'raylib'" />
      <NativeFileReference Include="$(SdlWasmLib)" />
    </ItemGroup>
  </Target>

</Project>
