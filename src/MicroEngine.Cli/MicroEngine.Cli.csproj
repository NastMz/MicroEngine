<Project Sdk="Microsoft.NET.Sdk">
  <!-- `microengine`, the SDK's command-line tool (docs/guide/cli.md): creates, runs, builds and packages games for every
       official target. Installed with `dotnet tool install -g MicroEngine.Cli`. It drives the .NET SDK and each system's
       own tools; it holds the hosts that run a game on Android, iOS and in browsers (Hosts/), and the engine's notices
       every package carries (Notices/). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>MicroEngine.Cli</RootNamespace>
    <!-- Not "microengine": next to MicroEngine.dll that name collides on case-insensitive file systems. -->
    <AssemblyName>MicroEngine.Cli</AssemblyName>
    <PackageId>MicroEngine.Cli</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>microengine</ToolCommandName>
    <Description>The MicroEngine command-line tool: create, run, build and package MicroEngine games for Windows, Linux, macOS, Android, iOS and the web.</Description>
    <PackageTags>$(PackageTags);dotnet-tool;cli;packaging</PackageTags>
    <!-- A tool has no consumers of its symbols or API documentation. -->
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- Host templates: copied, never compiled here. -->
    <Compile Remove="Hosts/**" />
    <None Remove="Hosts/**" />
    <Content Include="Hosts/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
    <Content Include="Notices/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
    <Content Include="../../LICENSE" Link="Notices/microengine-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
    <Content Include="../../THIRD-PARTY-NOTICES.md" Link="Notices/THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="false" />
    <InternalsVisibleTo Include="MicroEngine.Cli.Tests" />
    <!-- PNG reading and writing for icons. -->
    <ProjectReference Include="../MicroEngine/MicroEngine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- `microengine shaders`: SPIRV-Cross (C API and its native library for every desktop system, through Silk.NET)
         turns SPIR-V into MSL and reflects resource counts; it ships with the tool. -->
    <PackageReference Include="Silk.NET.SPIRV.Cross" Version="[2.22.0]" />
    <!-- DXC (HLSL to DXIL and SPIR-V) is Microsoft's, under its own licence terms, with Windows binaries only: the tool
         does not ship it but finds it in the NuGet packages folder and restores this exact version there on first use
         (Shaders.cs). Referenced here without assets only so that repository builds and tests have it in the cache. -->
    <PackageReference Include="Microsoft.Direct3D.DXC" Version="[1.8.2505.32]" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>
</Project>
