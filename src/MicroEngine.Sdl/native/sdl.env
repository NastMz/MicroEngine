# The SDL sources the browser build of MicroEngine.Sdl links (read by build.sh): the commit the ppy.SDL3-CS binding in
# MicroEngine.Sdl.csproj was built from (its desktop SDL3 library reports "SDL-3.5.0-ea7a2da"), so the C# bindings and
# the native code agree. Updating it is deliberate: change it together with the ppy.SDL3-CS version, rebuild
# (build.sh browser-wasm) and run the browser suites (web/tests).
SDL_REPO=https://github.com/libsdl-org/SDL.git
SDL_VERSION=3.5.0
SDL_COMMIT=ea7a2dabfd1ab6b0a5720568ffd207f5825e47f1
