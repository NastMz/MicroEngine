# Pinned versions for the experimental Android host; read by platforms/android/build-raylib.sh and platforms.yml.
NDK_VERSION=27.3.13750724             # NDK r27d (LTS)
ANDROID_API=24                        # minimum API level, also SupportedOSPlatformVersion in the project
EMULATOR_API=34                       # system image used by the emulator check (google_apis, x86_64)
