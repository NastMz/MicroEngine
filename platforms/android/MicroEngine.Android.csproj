<Project Sdk="Microsoft.NET.Sdk">
  <!-- Experimental Android host (platforms/README.md): one APK per game, -p:Game=<Id> (default MeadowRun).
       Needs the android workload and raylib built by build-raylib.sh. -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>MicroEngine.Android</RootNamespace>
    <ApplicationId>dev.microengine.$(Game.ToLowerInvariant())</ApplicationId>
    <ApplicationTitle>$(GameTitle)</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <RuntimeIdentifiers>android-x64;android-arm64</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <!-- android-x64 falls back to linux-x64 in the runtime graph, so the package's glibc build of raylib would be
         packaged; only the NDK builds from build-raylib.sh may reach the APK. -->
    <PackageReference Include="Raylib-cs" Version="[8.1.0]" ExcludeAssets="native" />
    <!-- native/out/<abi>/libraylib.so (build-raylib.sh) is packaged by the SDK's default items, its ABI taken from
         the folder name. -->
    <!-- Input scripts, so a test can replay the same runs as desktop.mjs. -->
    <AndroidAsset Include="$(GameDir)scripts/*.script" Link="scripts/%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="_CheckRaylibAndroid" BeforeTargets="Build">
    <Error Condition="!Exists('native/out/x86_64/libraylib.so') or !Exists('native/out/arm64-v8a/libraylib.so')"
           Text="raylib for Android is missing in platforms/android/native/out. Run platforms/android/build-raylib.sh first." />
  </Target>
</Project>
