<Project Sdk="Microsoft.NET.Sdk">
  <!-- Android host (platforms/README.md): one APK per game, -p:Game=<Id> (default MeadowRun), running on SDL3.
       Needs the android workload and an Android SDK; SDL3 for every ABI comes from the ppy.SDL3-CS package. -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>MicroEngine.Android</RootNamespace>
    <ApplicationId>dev.microengine.$(Game.ToLowerInvariant())</ApplicationId>
    <ApplicationTitle>$(GameTitle)</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <RuntimeIdentifiers>android-x64;android-arm64</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <!-- The games reference the desktop platforms, raylib among them; android-x64 falls back to linux-x64 in the runtime
         graph, so the package's glibc build of raylib would be packaged. raylib is not used on Android. -->
    <PackageReference Include="Raylib-cs" Version="[8.1.0]" ExcludeAssets="native" />
    <!-- Input scripts, so a test can replay the same runs as desktop.mjs, and the game's content files. -->
    <AndroidAsset Include="$(GameDir)scripts/*.script" Link="scripts/%(Filename)%(Extension)" />
    <AndroidAsset Include="@(MobileGameContent)" Link="Content/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
