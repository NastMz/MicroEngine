<?xml version="1.0" encoding="utf-8"?>
<!-- Native libraries are extracted to the app's library folder, so .NET's P/Invoke and NativeActivity load the same
     libraylib.so file, and both see the one raylib instance android_main initialized. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-feature android:glEsVersion="0x00020000" android:required="true" />
  <application android:extractNativeLibs="true" android:hasCode="true" android:allowBackup="false" />
</manifest>
