# Pinned versions for the experimental iOS host; read by platforms.yml.
# Each workload set's ios pack requires one Xcode version. Set 10.0.401 brings ios 26.5.10318, which requires Xcode 26.6
# (on the hosted macOS image; the build selects it). Set 10.0.403 brings ios 27.1.10018, which requires Xcode 27.1,
# not on the image yet (run 41208502165).
IOS_WORKLOAD_SET=10.0.401             # installed with the SDK pinned in web/toolchain.env (same 10.0.4xx band)
