# Pinned versions for the experimental iOS host; read by platforms.yml.
# The ios pack in a workload set requires one Xcode version: set 10.0.401 brings ios 26.5.10318, which needs Xcode 26.5,
# available on the hosted macOS image (10.0.402 and 10.0.403 need Xcode 27.0 and 27.1, which it does not have yet).
IOS_WORKLOAD_SET=10.0.401             # installed with the SDK pinned in web/toolchain.env (same 10.0.4xx band)
