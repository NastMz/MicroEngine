<Project Sdk="Microsoft.NET.Sdk">
  <!-- iOS host (platforms/README.md): runs the -p:Game=<Id> game (default MeadowRun) on SDL3 with Metal. SDL3 comes as an
       xcframework (device and simulator) from the ppy.SDL3-CS package. Needs macOS, Xcode and the ios workload. -->
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>MicroEngine.iOS</RootNamespace>
    <ApplicationId>dev.microengine.$(Game.ToLowerInvariant())</ApplicationId>
    <ApplicationTitle>$(GameTitle)</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">iossimulator-arm64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <!-- The games reference the desktop platforms, raylib among them; raylib has no iOS build and is not used here. -->
    <PackageReference Include="Raylib-cs" Version="[8.1.0]" ExcludeAssets="native" />
    <BundleResource Include="$(GameDir)scripts/*.script" Link="scripts/%(Filename)%(Extension)" />
    <BundleResource Include="@(MobileGameContent)" Link="Content/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
