<Project InitialTargets="_CheckMobileGame">
  <Target Name="_CheckMobileGame">
    <Error Condition="'$(GameFactory)' == ''" Text="Unknown game '$(Game)'. Known games are the entries in web/games.props." />
  </Target>

  <ItemGroup>
    <!-- The game is an ordinary net10.0 library build: no device runtime identifier, shared with desktop builds. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)../games/$(GameProject)" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The selected game's entry point, generated from web/games.props as the browser host does. -->
  <Target Name="_WriteMobileGameEntry" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_GameEntryFile>$(IntermediateOutputPath)GameEntry.g.cs</_GameEntryFile>
      <_GameEntryCode>// Generated from web/games.props for -p:Game=$(Game).
internal static class GameEntry
{
    public const string Id = "$(Game)"%3B
    public const string Title = "$(GameTitle)"%3B
    public static MicroEngine.Core.Game Create() => $(GameFactory)%3B
}</_GameEntryCode>
    </PropertyGroup>
    <WriteLinesToFile File="$(_GameEntryFile)" Lines="$(_GameEntryCode)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_GameEntryFile)" />
      <FileWrites Include="$(_GameEntryFile)" />
    </ItemGroup>
  </Target>
</Project>
