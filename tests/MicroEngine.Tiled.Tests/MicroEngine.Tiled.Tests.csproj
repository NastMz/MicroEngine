<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Tiled package's tests: real map files in both of Tiled's formats (Maps/), read through the public API. -->
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MicroEngine.Tiled/MicroEngine.Tiled.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Maps/**" Exclude="Maps/generate.mjs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
