<Project Sdk="Microsoft.NET.Sdk">
  <!-- The transitional Entity/EntityList adapter's own tests. Deleted with the adapter at the end of ARCH-1 stage 5
       (the architecture test allows this project, and the demos, to reference it). -->
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <!-- The adapter is obsolete on purpose; its own tests use it. -->
    <NoWarn>$(NoWarn);MEMIG001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/AllocationAssert.cs" Link="Shared/AllocationAssert.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MicroEngine.Migration.Entities/MicroEngine.Migration.Entities.csproj" />
  </ItemGroup>
</Project>
