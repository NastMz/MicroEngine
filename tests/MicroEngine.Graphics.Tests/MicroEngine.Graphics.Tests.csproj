<Project Sdk="Microsoft.NET.Sdk">
  <!-- The graphics device contract (its core validation, handles and counters, and the device conformance suite run
       against the CPU reference device) and the 2D layer over it (batcher, camera). It references only
       MicroEngine.Graphics and MicroEngine.Graphics2D (and through them the kernel and the platform contracts), so both
       are proven usable without the rest of the engine. The suite itself lives in
       tests/Shared/Graphics and also runs against the native devices in tests/MicroEngine.Desktop.Tests. -->
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MicroEngine.Graphics/MicroEngine.Graphics.csproj" />
    <ProjectReference Include="../../src/MicroEngine.Graphics2D/MicroEngine.Graphics2D.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/Graphics/*.cs" LinkBase="Shared/Graphics" />
    <!-- The suite's custom shaders (HLSL in tests/Shared/Graphics/Shaders, compiled offline), read from shaders/ at run time. -->
    <None Include="../Shared/Graphics/Shaders/compiled/*" Link="shaders/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
