<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plays the samples: the tutorial's finished game and the focused examples the documentation quotes, and the asset
       pipeline's HD gallery. -->
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../samples/GemGarden/part4-complete/GemGarden.csproj" />
    <ProjectReference Include="../../samples/Examples/Examples.csproj" />
    <ProjectReference Include="../../samples/AssetGallery/AssetGallery.csproj" />
    <ProjectReference Include="../../samples/TiledLevel/TiledLevel.csproj" />
  </ItemGroup>
  <!-- The simulation-determinism helper shared with the engine's and the games' test projects. -->
  <ItemGroup>
    <Compile Include="../Shared/StateTraceRuns.cs" Link="Shared/StateTraceRuns.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The gallery's tour, played by the tests as the launcher plays it. -->
    <None Include="../../samples/AssetGallery/scripts/tour.script" Link="scripts/tour.script" CopyToOutputDirectory="PreserveNewest" />
    <!-- The examples' tour, checked against the list of examples. -->
    <None Include="../../samples/Examples/scripts/tour.script" Link="scripts/examples-tour.script" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
