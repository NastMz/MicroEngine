<Project Sdk="Microsoft.NET.Sdk">
  <!-- The stress harness's own logic (benchmarks/StressBench): statistics, options, results, comparison with a
       baseline, the limit search, and that every workload is reproducible. The measurements are not tests. -->
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../benchmarks/StressBench/StressBench.csproj" />
    <!-- The entity workloads of ENTITY-1: every store must end a workload in the same state. -->
    <ProjectReference Include="../../benchmarks/EcsBench/EcsBench.csproj" />
    <ProjectReference Include="../../benchmarks/FsmCompare/FsmCompare.csproj" />
    <!-- The modelling comparison of ENTITY-1: both models must show the same slice at every step. -->
    <ProjectReference Include="../../benchmarks/EcsModel/EcsModel.csproj" />
  </ItemGroup>
</Project>
