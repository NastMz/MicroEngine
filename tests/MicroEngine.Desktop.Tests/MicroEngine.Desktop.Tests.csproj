<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MicroEngine.Desktop/MicroEngine.Desktop.csproj" />
    <ProjectReference Include="../../src/MicroEngine.Graphics.SdlGpu/MicroEngine.Graphics.SdlGpu.csproj" />
    <ProjectReference Include="../../src/MicroEngine.Graphics3D/MicroEngine.Graphics3D.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The native keyboard (XTEST) and sound-server helpers the raylib tests use, so SDL is checked the same way. -->
    <Compile Include="../MicroEngine.Raylib.Tests/Shared/*.cs" LinkBase="Shared" />
    <!-- The graphics device conformance suite, run here against the SDL and raylib devices. -->
    <Compile Include="../Shared/Graphics/*.cs" LinkBase="Shared/Graphics" />
    <!-- The suite's custom shaders (HLSL in tests/Shared/Graphics/Shaders, compiled offline), read from shaders/ at run time. -->
    <None Include="../Shared/Graphics/Shaders/compiled/*" Link="shaders/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Meshes and glTF files built in code for the 3D tests. -->
    <Compile Include="../Shared/Graphics3D/*.cs" LinkBase="Shared/Graphics3D" />
    <!-- The allocation check the engine tests use. -->
    <Compile Include="../Shared/AllocationAssert.cs" Link="Shared/AllocationAssert.cs" />
  </ItemGroup>
</Project>
