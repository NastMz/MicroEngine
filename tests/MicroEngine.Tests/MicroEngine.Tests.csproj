<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MicroEngine/MicroEngine.csproj" />
  </ItemGroup>
  <!-- The simulation-determinism helper and the allocation check shared with the games' test projects. -->
  <ItemGroup>
    <Compile Include="../Shared/StateTraceRuns.cs" Link="Shared/StateTraceRuns.cs" />
    <Compile Include="../Shared/AllocationAssert.cs" Link="Shared/AllocationAssert.cs" />
    <!-- The physics conformance suites every 2D backend runs (common contract and capability suites). -->
    <Compile Include="../Shared/Physics/*.cs" LinkBase="Shared/Physics" />
  </ItemGroup>
  <!-- Real asset files for the asset pipeline tests: the AssetGallery sample's fonts and atlases, not copies. -->
  <ItemGroup>
    <None Include="../../samples/AssetGallery/Content/**" Exclude="../../samples/AssetGallery/Content/**/*.cs" LinkBase="Gallery" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
