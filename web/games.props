<Project>
  <!-- The games the web host can build, selected with -p:Game=<Id>. Each entry is everything that differs
       between games: a title, the game project (under games/) and the expression that builds the game, the
       same one its desktop Program.cs passes to DesktopLauncher (minus the save directory: the browser
       stores saves in localStorage). A Content folder next to the project is shipped when it exists.
       Adding a demo to the web build means adding one entry here (see web/README.md). -->
  <PropertyGroup Condition="'$(Game)' == 'MeadowRun'">
    <GameTitle>Meadow Run</GameTitle>
    <GameProject>MeadowRun/MeadowRun.csproj</GameProject>
    <GameFactory>new MeadowRun.MeadowGame(null, MeadowRun.LaunchOptions.FromEnvironment())</GameFactory>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Game)' == 'CourtyardKey'">
    <GameTitle>Courtyard Key</GameTitle>
    <GameProject>CourtyardKey/CourtyardKey.csproj</GameProject>
    <GameFactory>new CourtyardKey.CourtyardKeyGame(null, Environment.GetEnvironmentVariable("COURTYARD_START"))</GameFactory>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Game)' == 'TrailDuel'">
    <GameTitle>Trail Duel</GameTitle>
    <GameProject>TrailDuel/TrailDuel.csproj</GameProject>
    <GameFactory>new TrailDuel.TrailDuelGame()</GameFactory>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Game)' == 'NeonRift'">
    <GameTitle>Neon Rift</GameTitle>
    <GameProject>NeonRift/NeonRift.csproj</GameProject>
    <GameFactory>new NeonRift.RiftGame(NeonRift.LaunchOptions.FromEnvironment())</GameFactory>
  </PropertyGroup>
</Project>
