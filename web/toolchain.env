# Pinned versions for MicroEngine web builds; read by web/setup.sh and web/build.sh.
# They move together: the wasm-tools workload of this SDK brings its own emscripten, and raylib must be
# compiled by that same emscripten (see web/README.md, "Why raylib is rebuilt").
DOTNET_SDK_VERSION=10.0.403           # .NET SDK installed privately (never touches the system SDK)
DOTNET_WORKLOAD_SET=10.0.403          # workload set for `dotnet workload install wasm-tools`
DOTNET_RUNTIME_VERSION=10.0.14        # runtime the SDK ships; must match the browser-wasm runtime pack
EMSCRIPTEN_VERSION=3.1.56             # emscripten inside that workload
RAYLIB_TAG=6.0                        # raylib release that Raylib-cs 8.1.0 binds
RAYLIB_COMMIT=dbc56a87da87d973a9c5baa4e7438a9d20121d28
RAYLIB_REPO=https://github.com/raysan5/raylib.git
