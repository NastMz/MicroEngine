<Project InitialTargets="_CheckWebGame">
  <Target Name="_CheckWebGame">
    <Error Condition="'$(Game)' == ''" Text="Choose a game: -p:Game=&lt;Id&gt;, one of the entries in web/games.props (or run web/build.sh)." />
    <Error Condition="'$(GameFactory)' == ''" Text="Unknown game '$(Game)'. Known games are the entries in web/games.props." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)../games/$(GameProject)')" Text="Game project games/$(GameProject) for '$(Game)' does not exist." />
  </Target>

  <ItemGroup Condition="'$(GameProject)' != ''">
    <ProjectReference Include="$(MSBuildThisFileDirectory)../games/$(GameProject)" />
  </ItemGroup>

  <!-- The selected game's entry point: its id, title and constructor, generated from web/games.props. -->
  <Target Name="_WriteGameEntry" BeforeTargets="CoreCompile" Condition="'$(GameFactory)' != ''">
    <PropertyGroup>
      <_GameEntryFile>$(IntermediateOutputPath)GameEntry.g.cs</_GameEntryFile>
      <_GameEntryCode>// Generated from web/games.props for -p:Game=$(Game).
internal static class GameEntry
{
    public const string Id = "$(Game)"%3B
    public const string Title = "$(GameTitle)"%3B
    public const bool DevHooks = $(WebDevHooks.ToLowerInvariant())%3B
    public static MicroEngine.Core.Game Create() => $(GameFactory)%3B
}</_GameEntryCode>
    </PropertyGroup>
    <WriteLinesToFile File="$(_GameEntryFile)" Lines="$(_GameEntryCode)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_GameEntryFile)" />
      <FileWrites Include="$(_GameEntryFile)" />
    </ItemGroup>
  </Target>

  <!-- Raylib-cs ships a browser raylib.a built by a newer emscripten than .NET's (wasm-opt rejects it), so
       link the copy rebuilt by web/setup.sh with the workload's own emcc instead. -->
  <Target Name="_UseRebuiltRaylib" BeforeTargets="_PrepareForBrowserWasmBuildNative">
    <Error Condition="!Exists('$(RaylibWasmLib)')" Text="Missing $(RaylibWasmLib). Run web/setup.sh first, or pass -p:RaylibWasmLib=&lt;path&gt; (see web/README.md)." />
    <ItemGroup>
      <NativeFileReference Remove="@(NativeFileReference)" Condition="'%(Filename)' == 'raylib'" />
      <NativeFileReference Include="$(RaylibWasmLib)" />
    </ItemGroup>
  </Target>

  <!-- Game files served next to the page. content.txt lists the Content files, which the page copies into the
       runtime's virtual file system at /Content before the game starts, so ContentFolder reads them exactly as
       on desktop. game.json describes the package for the page and for whoever embeds it. -->
  <ItemGroup Condition="'$(GameContentDir)' != ''">
    <_GameContent Include="$(GameContentDir)**" Exclude="$(GameContentDir)**/*.cs" />
    <Content Include="@(_GameContent)" Link="wwwroot/Content/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(WebDevHooks)' == 'true'">
    <Content Include="$(GameDir)scripts/*.script" Link="wwwroot/scripts/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="_WriteGamePackageFiles" BeforeTargets="AssignTargetPaths" Condition="'$(GameFactory)' != ''">
    <WriteLinesToFile File="$(IntermediateOutputPath)content.txt" Lines="@(_GameContent->'%(RecursiveDir)%(Filename)%(Extension)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(IntermediateOutputPath)game.json" Lines="{ &quot;id&quot;: &quot;$(Game)&quot;, &quot;title&quot;: &quot;$(GameTitle)&quot;, &quot;dev&quot;: $(WebDevHooks.ToLowerInvariant()) }" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Content Include="$(IntermediateOutputPath)content.txt" Link="wwwroot/content.txt" CopyToPublishDirectory="PreserveNewest" />
      <Content Include="$(IntermediateOutputPath)game.json" Link="wwwroot/game.json" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
