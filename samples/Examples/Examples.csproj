<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Examples</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationTitle>MicroEngine Examples</ApplicationTitle>
    <ApplicationId>com.example.microengine_examples</ApplicationId>
    <Version>1.0.0</Version>
    <Description>Small, focused examples of the MicroEngine SDK, one screen per topic.</Description>
    <MicroEngineIcon>icon.png</MicroEngineIcon>
    <MicroEngineGameFactory>new Examples.ExamplesGame()</MicroEngineGameFactory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MicroEngine.Desktop" Version="0.5.0-alpha.1" />
    <!-- Shaped text for the right-to-left example: optional, with HarfBuzz. -->
    <PackageReference Include="MicroEngine.Text.Shaping" Version="0.5.0-alpha.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Content/**" CopyToOutputDirectory="PreserveNewest" LinkBase="Content" />
  </ItemGroup>
</Project>
