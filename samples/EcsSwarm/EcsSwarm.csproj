<Project Sdk="Microsoft.NET.Sdk">
  <!-- An Entity Component System beside the scene's world: twenty thousand alike objects live in a component store
       (the optional MicroEngine.Ecs package, over the Arch library), the few objects that need a transform hierarchy
       stay entities of the scene's world, and a carrier is both, linked. The store is a scene system: the scene adds
       it and lists its systems, and the engine steps it, hashes it and ends it with the scene. It references the
       packages a game outside this repository references; inside the repository the engine's projects replace them
       (samples/Directory.Build.targets, and Directory.Build.targets here for the optional package). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EcsSwarm</RootNamespace>
    <ApplicationTitle>ECS Swarm</ApplicationTitle>
    <ApplicationId>com.example.ecsswarm</ApplicationId>
    <Version>1.0.0</Version>
    <Description>A swarm in a component store, beside the objects of a MicroEngine scene.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MicroEngine.Desktop" Version="0.6.0-alpha.1" />
    <!-- The component store: optional, and it brings the Arch library with it. -->
    <PackageReference Include="MicroEngine.Ecs" Version="0.6.0-alpha.1" />
  </ItemGroup>
</Project>
