<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pathfinding with the optional MicroEngine.Navigation package: a unit that walks where the pointer clicks, a
       chaser, a swarm that reads one distance field, and a patrol that searches again when a door closes. Everything
       is drawn by code. It references the packages a game outside this repository references; inside the repository
       the projects replace them (samples/Directory.Build.targets). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Pathfinding</RootNamespace>
    <ApplicationTitle>Pathfinding</ApplicationTitle>
    <ApplicationId>com.example.pathfinding</ApplicationId>
    <Version>1.0.0</Version>
    <Description>Agents that find their way through a tile map with MicroEngine.Navigation.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MicroEngine.Desktop" Version="0.6.0-alpha.1" />
    <PackageReference Include="MicroEngine.Navigation" Version="0.6.0-alpha.1" />
  </ItemGroup>
</Project>
