<Project Sdk="Microsoft.NET.Sdk">
  <!-- Navigation with the optional MicroEngine.Navigation package, in three scenes: a room with a unit that walks
       where the pointer clicks, a chaser, a swarm that reads one distance field and a patrol that goes around when a
       door closes; a group of units of two sizes sent to one point; and a tower defence where towers are built in
       the way of a wave. Everything is drawn by code. It references the packages a game outside this repository references; inside the repository
       the projects replace them (samples/Directory.Build.targets). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Pathfinding</RootNamespace>
    <ApplicationTitle>Pathfinding</ApplicationTitle>
    <ApplicationId>com.example.pathfinding</ApplicationId>
    <Version>1.0.0</Version>
    <Description>Agents that find their way, keep apart and go around what is built in their way, with MicroEngine.Navigation.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MicroEngine.Desktop" Version="0.6.0-alpha.1" />
    <PackageReference Include="MicroEngine.Navigation" Version="0.6.0-alpha.1" />
  </ItemGroup>
</Project>
