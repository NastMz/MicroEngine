<Project>
  <!-- Inside the repository the samples build against the engine's source (samples/Directory.Build.targets); this
       adds the same swap for the optional Entity Component System package. A copy of the sample outside the
       repository has neither file above it nor the engine's source, and keeps its package references. -->
  <Import Project="$(MSBuildThisFileDirectory)../Directory.Build.targets" Condition="Exists('$(MSBuildThisFileDirectory)../Directory.Build.targets')" />
  <ItemGroup Condition="'$(MicroEngineUsePackages)' != 'true' and Exists('$(MSBuildThisFileDirectory)../../src/MicroEngine.Ecs/MicroEngine.Ecs.csproj')">
    <PackageReference Remove="MicroEngine.Ecs" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../src/MicroEngine.Ecs/MicroEngine.Ecs.csproj" />
  </ItemGroup>
</Project>
