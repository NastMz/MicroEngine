<Project Sdk="Microsoft.NET.Sdk">
  <!-- Modelling with an Entity Component System: status effects that are added to and removed from live objects
       (burning that spreads, ice that stops and shatters, a shield that takes one hit), two kinds of object that share
       some behaviours and not others, and a question about a combination of them. Everything is a row of the scene's
       component store (the optional MicroEngine.Ecs package), and each behaviour is a system the scene lists in
       order. It references the packages a game outside this repository references; inside the repository the
       engine's projects replace them (samples/Directory.Build.targets, and Directory.Build.targets here). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EcsEffects</RootNamespace>
    <ApplicationTitle>ECS Effects</ApplicationTitle>
    <ApplicationId>com.example.ecseffects</ApplicationId>
    <Version>1.0.0</Version>
    <Description>Status effects as components and behaviours as ordered systems, in a MicroEngine scene.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MicroEngine.Desktop" Version="0.6.0-alpha.1" />
    <!-- The component store: optional, and it brings the Arch library with it. -->
    <PackageReference Include="MicroEngine.Ecs" Version="0.6.0-alpha.1" />
  </ItemGroup>
</Project>
