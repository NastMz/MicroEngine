<Project>
  <!-- Games are not SDK packages: `dotnet pack MicroEngine.slnx` packs only src/ and templates/. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- Samples that the documentation quotes (the tutorial checkpoints, the examples) are written exactly as a developer's
       project: they reference the published packages (<PackageReference Include="MicroEngine.Desktop" Version="..." />),
       so a copy outside this repository builds against nuget.org (sdk/tests/docs.mjs checks it). Inside the repository
       they build against the engine's source instead, so a change to the engine that breaks them fails here first.
       MicroEngineUsePackages=true keeps the package reference (the published SDK) inside the repository too. -->
  <ItemGroup Condition="'$(MicroEngineUsePackages)' != 'true'">
    <PackageReference Remove="MicroEngine.Desktop" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/MicroEngine.Desktop/MicroEngine.Desktop.csproj" />
    <!-- The optional shaping package (the examples' right-to-left text), the same way, for the samples that reference it. -->
    <_MicroEngineShaping Include="@(PackageReference->WithMetadataValue('Identity', 'MicroEngine.Text.Shaping'))" />
    <PackageReference Remove="MicroEngine.Text.Shaping" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/MicroEngine.Text.Shaping/MicroEngine.Text.Shaping.csproj" Condition="'@(_MicroEngineShaping)' != ''" />
    <!-- The optional Tiled maps package, the same way. -->
    <_MicroEngineTiled Include="@(PackageReference->WithMetadataValue('Identity', 'MicroEngine.Tiled'))" />
    <PackageReference Remove="MicroEngine.Tiled" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/MicroEngine.Tiled/MicroEngine.Tiled.csproj" Condition="'@(_MicroEngineTiled)' != ''" />
    <!-- The optional Box2D physics package, the same way. -->
    <_MicroEngineBox2D Include="@(PackageReference->WithMetadataValue('Identity', 'MicroEngine.Physics.Box2D'))" />
    <PackageReference Remove="MicroEngine.Physics.Box2D" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/MicroEngine.Physics.Box2D/MicroEngine.Physics.Box2D.csproj" Condition="'@(_MicroEngineBox2D)' != ''" />
  </ItemGroup>
  <!-- The samples use the same application-identity targets as any game built on the SDK packages
       (src/MicroEngine/build/MicroEngine.targets): a package reference imports them automatically, a project
       reference does not, so this file does. -->
  <Import Project="../src/MicroEngine/build/MicroEngine.targets" Condition="'$(MicroEngineUsePackages)' != 'true'" />
</Project>
