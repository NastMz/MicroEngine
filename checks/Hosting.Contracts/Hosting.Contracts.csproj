  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" PrivateAssets="all" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" PrivateAssets="all" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" PrivateAssets="all" />
    <ProjectReference Include="../../engine/Hosting/Hosting.csproj" />
    <ProjectReference Include="../../examples/LifecycleProbe/LifecycleProbe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
