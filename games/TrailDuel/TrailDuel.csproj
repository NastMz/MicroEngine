<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>TrailDuel</RootNamespace>
    <!-- The demo's application identity (docs/guide/app-identity.md): every package, web page and phone host reads it
         from here. The id keeps the one earlier demo packages used, so a new APK installs over an old one. -->
    <Version>1.0.0</Version>
    <ApplicationTitle>Trail Duel</ApplicationTitle>
    <ApplicationId>dev.microengine.trailduel</ApplicationId>
    <Description>A small creature-collecting, turn-based adventure built on MicroEngine.</Description>
    <MicroEngineIcon>icon.png</MicroEngineIcon>
    <MicroEngineSplashColor>#2b2140</MicroEngineSplashColor>
    <MicroEngineSplashBranding>true</MicroEngineSplashBranding>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TrailDuel.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MicroEngine.Desktop/MicroEngine.Desktop.csproj" />
  </ItemGroup>
</Project>
