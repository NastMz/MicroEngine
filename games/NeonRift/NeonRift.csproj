<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>NeonRift</RootNamespace>
    <!-- The demo's application identity (docs/guide/app-identity.md): every package, web page and phone host reads it
         from here. The id keeps the one earlier demo packages used, so a new APK installs over an old one. -->
    <Version>1.0.0</Version>
    <ApplicationTitle>Neon Rift</ApplicationTitle>
    <ApplicationId>dev.microengine.neonrift</ApplicationId>
    <Description>A run-and-gun pixel-art action game built on MicroEngine.</Description>
    <MicroEngineIcon>icon.png</MicroEngineIcon>
    <MicroEngineSplashColor>#0d0b1a</MicroEngineSplashColor>
    <MicroEngineSplashBranding>true</MicroEngineSplashBranding>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MicroEngine.Desktop/MicroEngine.Desktop.csproj" />
    <!-- Transitional: the legacy Entity/EntityList over IWorld until this game migrates to Scene.Objects (MEMIG001). -->
    <ProjectReference Include="../../src/MicroEngine.Migration.Entities/MicroEngine.Migration.Entities.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NeonRift.Tests" />
  </ItemGroup>
  <PropertyGroup>
    <NoWarn>$(NoWarn);MEMIG001</NoWarn>
  </PropertyGroup>
</Project>
