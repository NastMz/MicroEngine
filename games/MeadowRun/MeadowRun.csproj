<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>MeadowRun</RootNamespace>
    <!-- The demo's application identity (docs/guide/app-identity.md): every package, web page and phone host reads it
         from here. The id keeps the one earlier demo packages used, so a new APK installs over an old one. -->
    <Version>1.0.0</Version>
    <ApplicationTitle>Meadow Run</ApplicationTitle>
    <ApplicationId>dev.microengine.meadowrun</ApplicationId>
    <Description>A side-scrolling pixel-art platformer built on MicroEngine.</Description>
    <MicroEngineIcon>icon.png</MicroEngineIcon>
    <MicroEngineSplashColor>#5b9be8</MicroEngineSplashColor>
    <MicroEngineSplashBranding>true</MicroEngineSplashBranding>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MicroEngine.Desktop/MicroEngine.Desktop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MeadowRun.Tests" />
  </ItemGroup>
</Project>
