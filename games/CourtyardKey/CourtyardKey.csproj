<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CourtyardKey</RootNamespace>
    <!-- The demo's application identity (docs/guide/app-identity.md): every package, web page and phone host reads it
         from here. The id keeps the one earlier demo packages used, so a new APK installs over an old one. -->
    <Version>1.0.0</Version>
    <ApplicationTitle>Courtyard Key</ApplicationTitle>
    <ApplicationId>dev.microengine.courtyardkey</ApplicationId>
    <Description>A top-down pixel-art action-adventure built on MicroEngine.</Description>
    <MicroEngineIcon>icon.png</MicroEngineIcon>
    <MicroEngineSplashColor>#1b1726</MicroEngineSplashColor>
    <MicroEngineSplashBranding>true</MicroEngineSplashBranding>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MicroEngine.Desktop/MicroEngine.Desktop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CourtyardKey.Tests" />
  </ItemGroup>
</Project>
