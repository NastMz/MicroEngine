@@ -32,8 +32,21 @@
   </ItemGroup>
   <!-- Raylib-cs ships a browser raylib.a built by a newer emscripten than .NET's (wasm-opt rejects it), so link the copy
        built with the workload's own emscripten: from the MicroEngine.Raylib package, or web/setup.sh's. -->
+  <!-- ARCH-1 P4: link SDL3.a (experiments/arch-1/p4-sdl3-web/build-sdl3-wasm.sh, passed as the raylib-wasm option) instead of
+       raylib: the package's raylib.a and its GLFW JavaScript library are dropped, WebGL 2 is allowed for SDL_Renderer. -->
+  <PropertyGroup>
+    <EmccExtraLDFlags>$(EmccExtraLDFlags) -sMAX_WEBGL_VERSION=2</EmccExtraLDFlags>
+  </PropertyGroup>
+  <!-- With TrimMode=partial SDL3-CS is kept whole, so all of its ~1300 P/Invokes reach the native link and pull in
+       every SDL function. P4TrimSdl=true (an environment variable is enough) lets the trimmer remove the unused ones. -->
+  <ItemGroup Condition="'$(P4TrimSdl)' == 'true'">
+    <TrimmableAssembly Include="SDL3-CS" />
+  </ItemGroup>
   <Target Name="_UseWorkloadRaylib" BeforeTargets="_PrepareForBrowserWasmBuildNative">
-    <Error Condition="!Exists('$(RaylibWasmLib)')" Text="raylib for the web is missing ($(RaylibWasmLib)). It comes with the MicroEngine.Raylib package; in a MicroEngine checkout run web/setup.sh, or pass --raylib-wasm &lt;path&gt;." />
+    <Error Condition="!Exists('$(RaylibWasmLib)')" Text="SDL3.a is missing ($(RaylibWasmLib))." />
+    <PropertyGroup>
+      <EmccFlags>$(EmccFlags.Replace('-sUSE_GLFW=3', ''))</EmccFlags>
+    </PropertyGroup>
     <ItemGroup>
       <NativeFileReference Remove="@(NativeFileReference)" Condition="'%(Filename)' == 'raylib'" />
       <NativeFileReference Include="$(RaylibWasmLib)" />
